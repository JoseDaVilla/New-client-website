---
import { u } from '@/lib/url';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import SplitText from '@/components/SplitText.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import { site, offices } from '@/site.config';
import { bids, trades } from '@/data/services';

const fmt = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-CA', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const steps = ['Company', 'Capabilities', 'Documents'];
const process = [
  { t: 'Add your company', d: 'Add your company to our bidding list with your profile and prequalification documents.' },
  { t: 'Review', d: 'Our estimating team reviews safety, capacity and insurance. COR™ / ISO 45001 alignment is a plus.' },
  { t: 'Get invited', d: 'Approved partners are invited to price upcoming work by trade and region across Southern Ontario.' },
  { t: 'Build together', d: 'Join a team with an excellent relationship with its subcontractors, built to meet high demand and critical timing.' },
];
const formAction = site.formEndpoint || u('/thanks');
---

<Base title="Estimating" description="Add your company to the Grascan Build bidding list. Supplier and subcontractor prequalification and current tenders.">
  <PageHero
    index="04"
    eyebrow="Estimating & procurement"
    title="Add your company|to our bidding list."
    accent={['bidding', 'list.']}
    lead="As a general contractor, Grascan performs all associated civil work and maintains an excellent relationship with many subcontractors and suppliers to aid and assist with high demand and critical timing."
  >
    <div class="mt-12 flex flex-wrap gap-3" data-reveal style="--d:5">
      <Button href="#register">Add your company</Button>
      <Button href="#opportunities" variant="ghost">View open tenders</Button>
    </div>
  </PageHero>

  <!-- Proceso -->
  <section class="py-20 md:py-28">
    <div class="container-x">
      <Eyebrow index="01" class="mb-10 text-mute">How it works</Eyebrow>
      <ol class="grid gap-px overflow-hidden rounded-sm bg-ink/10 md:grid-cols-2 lg:grid-cols-4">
        {
          process.map((s, i) => (
            <li class="relative bg-bone p-8" data-reveal style={`--d:${i}`}>
              <span class="font-wide text-5xl font-extrabold text-signal">0{i + 1}</span>
              <h3 class="mt-10 font-semiwide text-2xl font-bold">{s.t}</h3>
              <p class="mt-3 text-ink/65">{s.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Licitaciones abiertas -->
  <section id="opportunities" class="on-dark scroll-mt-24 bg-ink py-20 text-bone md:py-28">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <Eyebrow index="02" class="mb-8 text-bone/50">Current opportunities</Eyebrow>
          <SplitText text="Open tenders." class="font-wide text-title font-extrabold uppercase" />
        </div>
        <p class="max-w-sm text-bone/60" data-reveal>Bid documents are shared with registered partners. Contact <a class="link-u text-bone" href={`mailto:${site.estimatingEmail}`}>{site.estimatingEmail}</a> to request access.</p>
      </div>

      <!-- Móvil: tarjetas -->
      <ul class="mt-12 space-y-3 md:hidden">
        {
          bids.map((b, i) => (
            <li class="rounded-sm border border-bone/10 bg-ink-2 p-5" data-reveal style={`--d:${i}`}>
              <div class="flex items-center justify-between gap-4">
                <span class="eyebrow text-signal">{b.id}</span>
                <span class="eyebrow text-bone/50">Closes <time datetime={b.closes}>{fmt(b.closes)}</time></span>
              </div>
              <p class="mt-3 font-semiwide text-xl font-bold">{b.project}</p>
              <p class="mt-1 text-sm text-bone/60">{b.location}</p>
              <p class="mt-3 text-sm text-bone/80">{b.trades}</p>
              <a href={`mailto:${site.estimatingEmail}?subject=${encodeURIComponent(`Bid documents request — ${b.id} ${b.project}`)}`} class="mt-5 inline-flex min-h-11 items-center gap-2 rounded-full bg-signal px-5 text-sm font-semibold text-on-signal">
                Request docs <Icon name="arrow" class="size-4" />
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Tablet / escritorio: tabla -->
      <div class="mt-14 hidden overflow-x-auto md:block" data-reveal>
        <table class="w-full text-left">
          <thead>
            <tr class="eyebrow border-b border-bone/15 text-bone/45">
              <th class="py-4 pr-6 font-medium">Ref.</th>
              <th class="py-4 pr-6 font-medium">Project</th>
              <th class="py-4 pr-6 font-medium">Location</th>
              <th class="py-4 pr-6 font-medium">Trades</th>
              <th class="py-4 pr-6 font-medium">Closes</th>
              <th class="py-4"><span class="sr-only">Action</span></th>
            </tr>
          </thead>
          <tbody>
            {
              bids.map((b) => (
                <tr class="group border-b border-bone/10 transition-colors hover:bg-bone/[0.03]">
                  <td class="eyebrow py-6 pr-6 text-signal">{b.id}</td>
                  <td class="py-6 pr-6 font-semiwide text-lg font-bold">{b.project}</td>
                  <td class="py-6 pr-6 text-bone/70">{b.location}</td>
                  <td class="py-6 pr-6 text-bone/70">{b.trades}</td>
                  <td class="py-6 pr-6"><time datetime={b.closes}>{fmt(b.closes)}</time></td>
                  <td class="py-6 text-right">
                    <a href={`mailto:${site.estimatingEmail}?subject=${encodeURIComponent(`Bid documents request — ${b.id} ${b.project}`)}`} class="inline-flex items-center gap-2 rounded-full border border-bone/20 px-4 py-2 text-sm transition-colors group-hover:border-signal group-hover:bg-signal group-hover:text-on-signal">
                      Request docs <Icon name="arrow" class="size-4" />
                    </a>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Formulario de registro de proveedores -->
  <section id="register" class="scroll-mt-24 py-20 md:py-32">
    <div class="container-x grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)]">
          <Eyebrow index="03" class="mb-8 text-mute">Supplier registration</Eyebrow>
          <SplitText text="Bidding list|registration." class="font-wide text-title font-extrabold uppercase" />
          <p class="mt-6 text-ink/65" data-reveal>Complete the prequalification form. It takes about 5 minutes. Have your safety statistics, insurance certificate and WSIB clearance handy.</p>

          <ol class="mt-10 space-y-3" data-steps-nav data-reveal>
            {
              steps.map((s, i) => (
                <li class="step-nav flex items-center gap-4" data-step-nav={i}>
                  <span class="step-dot grid size-9 place-items-center rounded-full border border-ink/20 font-mono text-xs">0{i + 1}</span>
                  <span class="font-semibold">{s}</span>
                </li>
              ))
            }
          </ol>

          <div class="mt-12 rounded-sm bg-concrete p-6 text-sm" data-reveal>
            <p class="eyebrow text-mute">Estimating contacts</p>
            <ul class="mt-4 space-y-2">
              {offices.map((o) => <li class="flex justify-between gap-4"><span class="font-semibold">{o.city}</span><a class="link-u" href={`tel:${o.phone.replace(/[^+\d]/g, '')}`}>{o.phone}</a></li>)}
            </ul>
          </div>
        </div>
      </div>

      <form
        name="supplier-registration"
        method="POST"
        action={formAction}
        enctype="multipart/form-data"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="supplier-form lg:col-span-7 lg:col-start-6"
        data-stepper
        novalidate
      >
        <input type="hidden" name="form-name" value="supplier-registration" />
        <p hidden><label>Don't fill this out: <input name="bot-field" /></label></p>

        <div class="mb-12 h-1 overflow-hidden rounded-full bg-ink/10"><div class="step-progress h-full origin-left bg-signal transition-transform duration-700" style="transform: scaleX(.3333)"></div></div>

        <!-- Paso 1 -->
        <fieldset class="step space-y-8" data-step="0">
          <legend class="mb-10 font-semiwide text-3xl font-bold">Company information</legend>
          <div class="grid gap-8 md:grid-cols-2">
            <div class="field md:col-span-2"><label class="field-label" for="company">Legal company name *</label><input class="input" id="company" name="company" required autocomplete="organization" /></div>
            <div class="field"><label class="field-label" for="contact">Contact name *</label><input class="input" id="contact" name="contact" required autocomplete="name" /></div>
            <div class="field"><label class="field-label" for="title">Title</label><input class="input" id="title" name="title" autocomplete="organization-title" /></div>
            <div class="field"><label class="field-label" for="email">Email *</label><input class="input" id="email" name="email" type="email" required autocomplete="email" /></div>
            <div class="field"><label class="field-label" for="phone">Phone *</label><input class="input" id="phone" name="phone" type="tel" required autocomplete="tel" /></div>
            <div class="field md:col-span-2"><label class="field-label" for="address">Business address</label><input class="input" id="address" name="address" autocomplete="street-address" /></div>
            <div class="field"><label class="field-label" for="website">Website</label><input class="input" id="website" name="website" type="url" placeholder="https://" /></div>
            <div class="field"><label class="field-label" for="years">Years in business</label><input class="input" id="years" name="years" type="number" min="0" inputmode="numeric" /></div>
            <div class="field">
              <label class="field-label" for="type">Company type *</label>
              <select class="input" id="type" name="type" required>
                <option value="">Select…</option>
                <option>Subcontractor</option>
                <option>Material supplier</option>
                <option>Equipment rental</option>
                <option>Consultant</option>
              </select>
            </div>
            <div class="field">
              <label class="field-label" for="union">Labour affiliation</label>
              <select class="input" id="union" name="union">
                <option value="">Select…</option>
                <option>Union</option>
                <option>Non-union</option>
                <option>Both</option>
              </select>
            </div>
          </div>
        </fieldset>

        <!-- Paso 2 -->
        <fieldset class="step space-y-10" data-step="1">
          <legend class="mb-10 font-semiwide text-3xl font-bold">Capabilities</legend>
          <div>
            <p class="field-label mb-4">Trades / scopes * <span class="normal-case tracking-normal">(select all that apply)</span></p>
            <div class="flex flex-wrap gap-2" data-group-required>
              {trades.map((t) => <label class="chip"><input type="checkbox" name="trades" value={t} class="sr-only" />{t}</label>)}
            </div>
          </div>
          <div>
            <p class="field-label mb-4">Regions served *</p>
            <div class="flex flex-wrap gap-2" data-group-required>
              {['Toronto', 'Peel', 'York', 'Durham', 'Halton', 'Hamilton / Niagara', 'Southwestern Ontario'].map((r) => <label class="chip"><input type="checkbox" name="regions" value={r} class="sr-only" />{r}</label>)}
            </div>
          </div>
          <div class="grid gap-8 md:grid-cols-3">
            <div class="field"><label class="field-label" for="capacity">Single project capacity</label><select class="input" id="capacity" name="capacity"><option value="">Select…</option><option>&lt; $500K</option><option>$500K – $2M</option><option>$2M – $10M</option><option>$10M+</option></select></div>
            <div class="field"><label class="field-label" for="bonding">Bonding capacity</label><input class="input" id="bonding" name="bonding" placeholder="$" /></div>
            <div class="field"><label class="field-label" for="employees">Employees</label><input class="input" id="employees" name="employees" type="number" min="0" inputmode="numeric" /></div>
            <div class="field"><label class="field-label" for="emr">EMR / safety rating</label><input class="input" id="emr" name="emr" inputmode="decimal" placeholder="e.g. 0.85" /></div>
            <div class="field"><label class="field-label" for="cor">COR™ certified?</label><select class="input" id="cor" name="cor"><option value="">Select…</option><option>Yes</option><option>In progress</option><option>No</option></select></div>
            <div class="field"><label class="field-label" for="trir">TRIR (last 3 yrs)</label><input class="input" id="trir" name="trir" inputmode="decimal" /></div>
          </div>
          <div class="field"><label class="field-label" for="projects">Recent relevant projects</label><textarea class="input" id="projects" name="projects" rows="4" placeholder="Project name, value, owner/GC, year"></textarea></div>
        </fieldset>

        <!-- Paso 3 -->
        <fieldset class="step space-y-10" data-step="2">
          <legend class="mb-10 font-semiwide text-3xl font-bold">Documents</legend>
          <label class="dropzone group relative flex cursor-pointer flex-col items-center justify-center gap-4 rounded-sm border border-dashed border-ink/25 bg-concrete/50 px-6 py-14 text-center transition-colors hover:border-signal">
            <span class="grid size-14 place-items-center rounded-full bg-ink text-bone transition-transform duration-500 group-hover:-translate-y-1"><Icon name="upload" class="size-6" /></span>
            <span class="font-semibold">Drop files here or <span class="text-signal underline underline-offset-4">browse</span></span>
            <span class="text-sm text-mute">Insurance certificate, WSIB clearance, COR™ / safety manual, company profile · PDF, max 10 MB each</span>
            <input type="file" name="documents" multiple accept=".pdf,.doc,.docx,.jpg,.png" class="absolute inset-0 cursor-pointer opacity-0" data-file-input />
          </label>
          <ul class="space-y-2 text-sm" data-file-list></ul>
          <div class="field"><label class="field-label" for="notes">Anything else we should know?</label><textarea class="input" id="notes" name="notes" rows="4"></textarea></div>
          <label class="flex items-start gap-3 text-sm text-ink/70">
            <input type="checkbox" name="consent" required class="mt-0.5 size-4 accent-signal" />
            I confirm the information provided is accurate and agree to be contacted about bid opportunities. *
          </label>
        </fieldset>

        <div class="mt-14 flex items-center justify-between gap-4 border-t border-ink/10 pt-8">
          <button type="button" class="btn btn-ghost" data-prev hidden>Back</button>
          <p class="text-sm text-mute" data-step-label>Step 1 of 3</p>
          <div class="flex gap-3">
            <button type="button" class="btn btn-dark" data-next>Continue <span class="btn-arrow"><Icon name="arrow" class="size-3.5" /></span></button>
            <button type="submit" class="btn btn-primary" data-submit hidden>Submit registration <span class="btn-arrow"><Icon name="arrow" class="size-3.5" /></span></button>
          </div>
        </div>
        <p class="mt-4 text-sm text-danger" data-form-error role="alert" hidden></p>
      </form>
    </div>
  </section>
</Base>

<style>
  /* Sin JS todos los pasos se muestran (formulario largo normal) */
  :global(.js) [data-stepper] .step:not(.is-active) {
    display: none;
  }
  :global(.js) [data-stepper] .step.is-active {
    animation: step-in 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(html:not(.js)) [data-next],
  :global(html:not(.js)) [data-step-label],
  :global(html:not(.js)) .step-progress {
    display: none;
  }
  :global(html:not(.js)) [data-submit] {
    display: inline-flex !important;
  }
  @keyframes step-in {
    from {
      opacity: 0;
      transform: translateX(24px);
    }
  }
  .step-nav.is-active .step-dot {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-bone);
  }
  .step-nav.is-done .step-dot {
    background: var(--color-signal);
    border-color: var(--color-signal);
    color: var(--color-ink);
  }
  .step-nav:not(.is-active):not(.is-done) {
    opacity: 0.45;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-stepper]');
  if (form) {
    const steps = [...form.querySelectorAll<HTMLFieldSetElement>('.step')];
    const navs = [...document.querySelectorAll<HTMLElement>('[data-step-nav]')];
    const prev = form.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-step-label]')!;
    const bar = form.querySelector<HTMLElement>('.step-progress')!;
    const error = form.querySelector<HTMLElement>('[data-form-error]')!;
    let current = 0;

    const show = (i: number) => {
      current = i;
      steps.forEach((s, k) => s.classList.toggle('is-active', k === i));
      navs.forEach((n, k) => {
        n.classList.toggle('is-active', k === i);
        n.classList.toggle('is-done', k < i);
      });
      prev.hidden = i === 0;
      next.hidden = i === steps.length - 1;
      submit.hidden = i !== steps.length - 1;
      label.textContent = `Step ${i + 1} of ${steps.length}`;
      bar.style.transform = `scaleX(${(i + 1) / steps.length})`;
      error.hidden = true;
    };

    const validate = (step: HTMLElement) => {
      let ok = true;
      step.querySelectorAll<HTMLInputElement>('input[required], select[required], textarea[required]').forEach((el) => {
        if (!el.checkValidity()) {
          ok = false;
          el.setAttribute('aria-invalid', 'true');
        } else el.removeAttribute('aria-invalid');
      });
      step.querySelectorAll<HTMLElement>('[data-group-required]').forEach((g) => {
        if (!g.querySelector('input:checked')) ok = false;
      });
      if (!ok) {
        error.textContent = 'Please complete the required fields (*) before continuing.';
        error.hidden = false;
        step.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
      }
      return ok;
    };

    next.addEventListener('click', () => {
      if (validate(steps[current])) {
        show(current + 1);
        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
    prev.addEventListener('click', () => show(current - 1));
    form.addEventListener('submit', (e) => {
      if (!validate(steps[current])) e.preventDefault();
    });

    // Lista de archivos seleccionados
    const input = form.querySelector<HTMLInputElement>('[data-file-input]');
    const list = form.querySelector<HTMLElement>('[data-file-list]');
    input?.addEventListener('change', () => {
      if (!list) return;
      list.innerHTML = '';
      [...(input.files || [])].forEach((f) => {
        const li = document.createElement('li');
        li.className = 'flex items-center justify-between gap-4 rounded-sm bg-concrete px-4 py-3';
        li.innerHTML = `<span class="truncate font-medium"></span><span class="eyebrow text-mute">${(f.size / 1024 / 1024).toFixed(1)} MB</span>`;
        li.firstElementChild!.textContent = f.name;
        list.append(li);
      });
    });

    show(0);
  }
</script>
