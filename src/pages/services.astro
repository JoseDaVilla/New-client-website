---
import { u } from '@/lib/url';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import ServiceIcon from '@/components/ServiceIcon.astro';
import Media from '@/components/Media.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import EstimatingCTA from '@/components/EstimatingCTA.astro';
import { services } from '@/data/services';
import { variants } from '@/lib/blueprint';

const projects = await getCollection('projects');
const related = (title: string) => projects.filter((p) => p.data.services.some((s) => title.includes(s) || s.includes(title))).slice(0, 2);
---

<Base title="Services" description="Construction management, general contracting, design-build, pre-construction, civil and industrial construction services.">
  <PageHero
    index="02"
    eyebrow="Services"
    title="Every phase.|One accountable|partner."
    lead="Whether you need early cost certainty, an integrated design-build team or a builder for critical infrastructure, we tailor the delivery model to your project."
  >
    <nav aria-label="Services" class="mt-14 flex flex-wrap gap-2" data-reveal style="--d:5">
      {services.map((s) => <a href={`#${s.slug}`} class="chip border-bone/20 text-bone/80 hover:text-bone">{s.title}</a>)}
    </nav>
  </PageHero>

  {
    services.map((s, i) => {
      const rel = related(s.title);
      const flip = i % 2 === 1;
      return (
        <section id={s.slug} class:list={['scroll-mt-24 py-20 md:py-32', i % 2 === 1 && 'bg-concrete']}>
          <div class="container-x grid gap-12 lg:grid-cols-12 lg:items-center">
            <div class:list={['lg:col-span-6', flip && 'lg:order-2 lg:col-start-7']}>
              <div class="flex items-center gap-5" data-reveal>
                <span class="eyebrow text-signal-ink">0{i + 1} / 0{services.length}</span>
                <ServiceIcon name={s.icon} class="size-12 text-signal" />
              </div>
              <h2 class="mt-8 font-wide text-title font-extrabold uppercase" data-reveal style="--d:1">{s.title}</h2>
              <p class="mt-6 max-w-xl text-lead text-ink/70" data-reveal style="--d:2">{s.description}</p>
              <ul class="mt-10 grid gap-x-8 sm:grid-cols-2" data-reveal style="--d:3">
                {s.capabilities.map((c) => (
                  <li class="flex items-center gap-3 border-b border-ink/10 py-3.5">
                    <Icon name="check" class="size-4 shrink-0 text-signal" />
                    {c}
                  </li>
                ))}
              </ul>
              {rel.length > 0 && (
                <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3" data-reveal style="--d:4">
                  <span class="eyebrow text-mute">Related work</span>
                  {rel.map((p) => <a href={u(`/projects/${p.id}`)} class="link-u font-semibold">{p.data.title}</a>)}
                </div>
              )}
            </div>
            <div class:list={['lg:col-span-5', flip ? 'lg:order-1 lg:col-start-1' : 'lg:col-start-8']} data-reveal="mask">
              <Media seed={`service-${s.slug}`} variant={variants[(i * 3 + 1) % variants.length]} class="aspect-[4/3] rounded-sm sm:aspect-[16/10] lg:aspect-[4/5]" tone={i % 2 ? 'dark' : 'light'} />
            </div>
          </div>
        </section>
      );
    })
  }

  <section class="bg-ink py-24 text-bone md:py-32">
    <div class="container-x flex flex-col items-start justify-between gap-10 md:flex-row md:items-end">
      <h2 class="max-w-3xl font-wide text-title font-extrabold uppercase" data-reveal>Not sure which delivery model fits?</h2>
      <div data-reveal style="--d:2"><Button href={u('/contact')}>Talk to our team</Button></div>
    </div>
  </section>

  <EstimatingCTA />
</Base>
