---
import FilterBar from '@/components/FilterBar.astro';
import { u } from '@/lib/url';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Media from '@/components/Media.astro';
import VideoFacade from '@/components/VideoFacade.astro';
import Lightbox from '@/components/Lightbox.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import SplitText from '@/components/SplitText.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// Galería global: se arma a partir de las galerías de los proyectos.
const photos = projects.flatMap((p) =>
  p.data.gallery.slice(0, 3).map((g, i) => ({ ...g, seed: `${p.id}-${i}`, project: p.data.title, sector: p.data.sector, href: `/projects/${p.id}` })),
);

// TODO: reemplazar VIDEO_ID por los vídeos reales del cliente (YouTube / Vimeo embed URLs)
const videos = [
  { title: 'Building Southern Ontario since 1987', duration: '02:00', embed: 'https://www.youtube-nocookie.com/embed/VIDEO_ID', variant: 'bridge' as const },
  { title: 'West Toronto Diamond bridge slide', duration: '01:30', embed: 'https://www.youtube-nocookie.com/embed/VIDEO_ID', variant: 'bridge' as const },
  { title: 'Gardiner Expressway re-decking', duration: '03:00', embed: 'https://www.youtube-nocookie.com/embed/VIDEO_ID', variant: 'road' as const },
];
const sectorsUsed = [...new Set(photos.map((p) => p.sector))];
---

<Base title="Photos & Videos" description="Photography and video from our projects, people and communities.">
  <PageHero index="06" eyebrow="Media" title="Seen from|the site." lead="Photography, time-lapses and films from Grascan projects across Southern Ontario. For high-resolution assets, contact our team." />

  <!-- Vídeos -->
  <section class="py-20 md:py-28">
    <div class="container-x">
      <Eyebrow class="mb-8 text-mute">Videos</Eyebrow>
      <SplitText text="In motion." class="font-wide text-title font-extrabold uppercase" />
      <div class="mt-14 grid gap-6 lg:grid-cols-2">
        <div class="lg:row-span-2" data-reveal="mask"><VideoFacade {...videos[0]} seed="v0" class="h-full lg:aspect-auto lg:min-h-full" /></div>
        {videos.slice(1).map((v, i) => <div data-reveal="mask" style={`--d:${i + 1}`}><VideoFacade {...v} seed={`v${i + 1}`} /></div>)}
      </div>
    </div>
  </section>

  <!-- Fotos -->
  <section class="on-dark bg-ink py-20 text-bone md:py-28">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <div>
          <Eyebrow class="mb-8 text-bone/50">Photography</Eyebrow>
          <SplitText text="Project gallery." class="font-wide text-title font-extrabold uppercase" />
        </div>
        <FilterBar target="photo-grid" label="Filter photos" tone="dark" items={sectorsUsed.map((s) => ({ value: s, label: s }))} class="w-full md:w-auto" />
      </div>

      <div id="photo-grid" class="mt-10 columns-2 gap-3 md:mt-14 md:gap-4 lg:columns-3">
        {
          photos.map((ph, i) => (
            <div class="mb-3 break-inside-avoid md:mb-4" data-tags={ph.sector}>
              <button type="button" class="group relative block w-full overflow-hidden text-left" data-lightbox="photos" data-caption={`${ph.project}, ${ph.caption}`} data-reveal style={`--d:${i % 3}`}>
                <Media src={ph.src} alt={`${ph.project}, ${ph.caption}`} seed={ph.seed} variant={ph.variant} label={false} class:list={[['aspect-[4/5]', 'aspect-[4/3]', 'aspect-square'][i % 3]]} imgClass="transition-transform duration-[1.2s] ease-(--ease-expo) group-hover:scale-105" sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" />
                <span class="absolute inset-x-0 bottom-0 flex flex-col bg-ink px-3 py-2.5 transition-opacity duration-500 can-hover:opacity-0 can-hover:group-hover:opacity-100 md:px-4 md:py-3">
                  <span class="eyebrow hidden text-signal sm:block">{ph.sector}</span>
                  <span class="mt-1 text-sm leading-tight font-semibold md:text-base">{ph.project}</span>
                  <span class="hidden text-sm text-bone/70 md:block">{ph.caption}</span>
                </span>
              </button>
            </div>
          ))
        }
      </div>
      <p class="py-20 text-center text-bone/50" data-filter-empty hidden>No photos in this category yet.</p>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="container-x flex flex-col items-start justify-between gap-8 md:flex-row md:items-end">
      <div>
        <Eyebrow class="mb-6 text-mute">Press & media kit</Eyebrow>
        <h2 class="max-w-2xl font-wide text-title font-extrabold uppercase" data-reveal>Need logos or high-res images?</h2>
      </div>
      <a href={u('/contact')} class="btn btn-dark" data-reveal style="--d:2"><span>Contact us</span></a>
    </div>
  </section>

  <Lightbox />
</Base>
