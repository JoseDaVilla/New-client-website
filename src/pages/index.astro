---
import { u } from '@/lib/url';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import SplitText from '@/components/SplitText.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Button from '@/components/Button.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import NewsCard from '@/components/NewsCard.astro';
import ServiceIcon from '@/components/ServiceIcon.astro';
import Marquee from '@/components/Marquee.astro';
import EstimatingCTA from '@/components/EstimatingCTA.astro';
import LocationsMap from '@/components/LocationsMap.astro';
import VideoFacade from '@/components/VideoFacade.astro';
import Icon from '@/components/Icon.astro';
import { stats, offices, clients } from '@/site.config';
import { services } from '@/data/services';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured).slice(0, 4);
const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const statement =
  'Since 1987, our ability to deliver time-sensitive, complicated and high-profile projects has made Grascan a preferred contractor for major road, bridge and rail construction in Southern Ontario.';
const lead = featured[0];
const homeServices = services.slice(0, 6);
---

<Base intro>
  <Hero featured={lead && { title: lead.data.title, href: `/projects/${lead.id}`, meta: `${lead.data.location} · ${lead.data.year}` }} />

  <!-- Statement + cifras -->
  <section id="discover" class="relative py-24 md:py-40">
    <div class="container-x">
      <Eyebrow index="01" class="mb-10 text-mute">Who we are</Eyebrow>
      <p class="max-w-6xl font-semiwide text-[clamp(1.6rem,3.4vw,3.4rem)] font-semibold leading-[1.1] tracking-[-0.02em] text-ink">
        {statement.split(' ').map((w) => <span class="scrub-word">{w} </span>)}
      </p>
      <div class="mt-12 flex flex-wrap items-center gap-6" data-reveal>
        <Button href={u('/about')} variant="dark">Our history</Button>
        <a href={u('/services')} class="link-u font-semibold">What we do</a>
      </div>

      <dl class="mt-20 grid grid-cols-2 border-t border-ink/10 md:mt-24 lg:grid-cols-4">
        {
          stats.map((s, i) => (
            <div class="relative border-b border-ink/10 py-8 pr-6 lg:border-b-0 [&:not(:last-child)]:lg:border-r lg:px-8 lg:first:pl-0" data-reveal style={`--d:${i}`}>
              <dt class="eyebrow text-mute">{s.label}</dt>
              <dd class="mt-4 whitespace-nowrap font-wide text-[clamp(2rem,3.6vw,3.9rem)] font-extrabold leading-none tracking-tight text-signal">
                {'prefix' in s && s.prefix}
                <span data-count={s.value} data-delay={i * 120}>0</span>
                <span class="text-gray">{s.suffix}</span>
              </dd>
              <dd class="mt-3 text-sm text-mute">{s.note}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Servicios -->
  <section class="on-dark relative bg-ink py-24 text-bone md:py-36">
    <div class="bg-grid pointer-events-none absolute inset-0 text-bone/40"></div>
    <div class="container-x relative">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <Eyebrow index="02" class="mb-8 text-bone/60">Services</Eyebrow>
          <SplitText text="Full-service.|From the ground up." class="font-wide text-display font-extrabold uppercase" />
        </div>
        <p class="text-lead text-bone/70 lg:col-span-5" data-reveal>From bridges and rapid transit to underground services and landscaping, Grascan self-performs and coordinates every phase of complex construction.</p>
      </div>

      <ul class="mt-16 border-t border-bone/12 md:mt-20">
        {
          homeServices.map((s, i) => (
            <li data-reveal style={`--d:${i % 3}`}>
              <a href={u(`/services#${s.slug}`)} class="service-row group grid grid-cols-[auto_1fr_auto] items-center gap-5 border-b border-bone/12 py-7 md:grid-cols-[5rem_auto_1fr_auto] md:gap-10 md:py-9">
                <span class="eyebrow hidden text-bone/40 md:inline">{String(i + 1).padStart(2, '0')}</span>
                <ServiceIcon name={s.icon} class="size-11 text-signal md:size-14" />
                <span>
                  <span class="block font-semiwide text-[clamp(1.4rem,3vw,2.8rem)] font-bold leading-none tracking-tight transition-transform duration-700 ease-(--ease-expo) group-hover:translate-x-3">{s.title}</span>
                  <span class="mt-3 block max-w-xl text-bone/55 md:hidden">{s.short}</span>
                </span>
                <span class="flex items-center gap-8">
                  <span class="hidden max-w-xs text-right text-bone/55 transition-colors group-hover:text-bone xl:block">{s.short}</span>
                  <span class="grid size-12 shrink-0 place-items-center rounded-full border border-bone/20 transition-all duration-500 ease-(--ease-expo) group-hover:rotate-[-45deg] group-hover:border-signal group-hover:bg-signal group-hover:text-on-signal">
                    <Icon name="arrow" class="size-5" />
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-12 flex flex-wrap items-center justify-between gap-6" data-reveal>
        <p class="max-w-2xl text-bone/60">+ {services.length - homeServices.length} more: {services.slice(homeServices.length).map((s) => s.title).join(' · ')}</p>
        <Button href={u('/services')}>All {services.length} services</Button>
      </div>
    </div>
  </section>

  <!-- Proyectos destacados -->
  <section class="py-24 md:py-36">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <div>
          <Eyebrow index="03" class="mb-8 text-mute">Featured projects</Eyebrow>
          <SplitText text="Landmarks|we've delivered." accent={["delivered."]} class="font-wide text-display font-extrabold uppercase" />
        </div>
        <div data-reveal><Button href={u('/projects')} variant="dark">All projects</Button></div>
      </div>

      <div class="mt-16 grid gap-x-8 gap-y-16 md:mt-24 md:grid-cols-12">
        {featured[0] && <div class="md:col-span-7"><ProjectCard project={featured[0]} size="lg" eager /></div>}
        {featured[1] && <div class="md:col-span-5 md:mt-40"><ProjectCard project={featured[1]} index={1} /></div>}
        {featured[2] && <div class="md:col-span-5"><ProjectCard project={featured[2]} /></div>}
        {featured[3] && <div class="md:col-span-7 md:mt-24"><ProjectCard project={featured[3]} size="lg" index={1} /></div>}
      </div>
    </div>
  </section>

  <!-- Organizaciones que invitan a licitar -->
  <section class="overflow-hidden border-y border-ink/10 bg-concrete py-10 md:py-14" aria-label="Invited to tender by">
    <p class="eyebrow mb-6 text-center text-mute">Invited to tender by</p>
    <Marquee items={clients} class="font-wide text-[clamp(1.6rem,4vw,3.4rem)] font-extrabold uppercase leading-none tracking-tight text-signal" speed="55s" />
  </section>

  <!-- Seguridad y cultura con vídeo -->
  <section class="py-24 md:py-36">
    <div class="container-x grid gap-14 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        <Eyebrow index="04" class="mb-8 text-mute">Safety & culture</Eyebrow>
        <SplitText text="Safety is|built into|everything." accent={['everything.']} class="font-wide text-title font-extrabold uppercase" />
        <p class="mt-8 max-w-md text-lg text-ink/70" data-reveal>Grascan has developed a reputation for adopting leading-edge safety practices. Our COR™ audit found overwhelming evidence of a strong safety culture, with every person committed to continual improvement.</p>
        <ul class="mt-10 grid grid-cols-2 gap-6" data-reveal style="--d:2">
          <li class="border-l-2 border-signal pl-4"><p class="font-wide text-3xl font-extrabold text-signal">COR™</p><p class="text-sm text-mute">Certified since 2015 · ISO 45001</p></li>
          <li class="border-l-2 border-gray pl-4"><p class="font-wide text-3xl font-extrabold text-signal">Platinum</p><p class="text-sm text-mute">Canada’s Best Managed Companies</p></li>
        </ul>
      </div>
      <div class="lg:col-span-7" data-reveal="mask">
        <VideoFacade title="Grascan — Building since 1987" seed="company-film" variant="bridge" duration="02:00" />
      </div>
    </div>
  </section>

  <EstimatingCTA />

  <!-- Noticias -->
  <section class="py-24 md:py-36">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <div>
          <Eyebrow index="05" class="mb-8 text-mute">News & updates</Eyebrow>
          <SplitText text="Latest news." class="font-wide text-display font-extrabold uppercase" />
        </div>
        <div data-reveal><Button href={u('/news')} variant="dark">All news</Button></div>
      </div>
      <div class="mt-12 grid gap-12 sm:grid-cols-2 sm:gap-x-6 md:mt-16 lg:grid-cols-3 lg:gap-8">
        {news.map((post, i) => <div class:list={[i === 0 && 'sm:col-span-2 lg:col-span-1']}><NewsCard post={post} index={i} /></div>)}
      </div>
    </div>
  </section>

  <!-- Ubicaciones -->
  <section class="relative overflow-hidden bg-concrete py-24 md:py-36">
    <div class="container-x grid gap-14 xl:grid-cols-12">
      <div class="xl:col-span-4">
        <Eyebrow index="06" class="mb-8 text-mute">Locations</Eyebrow>
        <SplitText text="Rooted in|the GTA." class="font-wide text-title font-extrabold uppercase" />
        <p class="mt-6 max-w-sm text-ink/70" data-reveal>Our main office and facility in Toronto and our Brampton facility support projects across Southern Ontario.</p>
        <div class="mt-10" data-reveal><Button href={u('/contact')} variant="dark">Contact us</Button></div>
      </div>
      <div class="xl:col-span-8">
        <div data-reveal="fade" class="rounded-sm border border-ink/10 bg-bone p-4 text-ink md:p-6"><LocationsMap /></div>
        <ul class="mt-6 grid gap-px overflow-hidden rounded-sm bg-ink/10 sm:grid-cols-2">
          {
            offices.map((o, i) => (
              <li class="bg-bone p-6" data-reveal style={`--d:${i}`}>
                <p class="eyebrow text-signal-ink">{o.label}</p>
                <p class="mt-2 font-semiwide text-2xl font-bold">{o.city}</p>
                <p class="mt-3 text-sm text-ink/60">{o.address.join(', ')}</p>
                <a class="link-u mt-3 inline-block text-sm font-semibold" href={`tel:${o.phone.replace(/[^+\d]/g, '')}`}>{o.phone}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>
