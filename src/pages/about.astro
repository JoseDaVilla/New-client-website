---
import { u } from '@/lib/url';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import SplitText from '@/components/SplitText.astro';
import Media from '@/components/Media.astro';
import Button from '@/components/Button.astro';
import Marquee from '@/components/Marquee.astro';
import EstimatingCTA from '@/components/EstimatingCTA.astro';
import { site, stats } from '@/site.config';
import { values, timeline, leadership, awards } from '@/data/services';
---

<Base title="About" description={`${site.legalName}: building Southern Ontario since ${site.founded}. Our history, culture, leadership and commitment to safety.`}>
  <PageHero
    index="01"
    eyebrow="About us"
    title={`Builders since|${site.founded}.`}
    accent={[`${site.founded}.`]}
    lead="Grascan has been servicing the construction needs of Southern Ontario since 1987. Approaching our 40th anniversary, we continue to leverage our experience, expertise and innovative spirit to deliver complicated projects."
  />

  <!-- Historia -->
  <section class="py-24 md:py-36">
    <div class="container-x grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <Eyebrow index="01" class="mb-8 text-mute">Our story</Eyebrow>
        <SplitText text="From roadwork|to landmark|projects." accent={["projects."]} class="font-wide text-title font-extrabold uppercase" />
      </div>
      <div class="space-y-6 text-lg leading-relaxed text-ink/75 lg:col-span-5 lg:col-start-8" data-reveal>
        <p>Grascan was incorporated in 1987 by owners <strong class="text-ink">Angelo Grassa and John Balazic</strong>. The company undertook basic roadwork when it launched, but it wasn't long before the founders decided to focus on more challenging, unique projects.</p>
        <p>By 2000, Grascan had solidified its position as captains of industry, completing some of the most high-profile jobs in the City of Toronto — including dismantling the Gardiner Expressway, something no other contractor in Ontario had done before.</p>
        <p>With over 36 years of experience completing Bid-Build projects, Grascan established an integrated Design-Build team that is successfully performing multiple major Design-Build projects for Metrolinx. <strong class="text-ink">Grascan Build</strong> now brings that experience to private construction.</p>
      </div>
    </div>

    <div class="container-x mt-20 grid gap-4 md:grid-cols-12">
      <div class="md:col-span-8" data-reveal="mask"><Media seed="about-hero" variant="midrise" class="aspect-[16/10] rounded-sm" /></div>
      <div class="grid gap-4 md:col-span-4" data-reveal="mask" style="--d:2">
        <Media seed="about-team" variant="campus" class="aspect-[4/3] rounded-sm md:aspect-auto" />
        <div class="on-dark flex flex-col justify-between rounded-sm bg-ink p-8">
          <p class="eyebrow text-gray">Our commitment</p>
          <p class="mt-6 font-semiwide text-2xl font-bold leading-tight">To be a model of innovation in the construction industry — delivering on time, on budget and safely.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Cifras -->
  <section class="border-y border-ink/10">
    <dl class="container-x grid grid-cols-2 lg:grid-cols-4">
      {
        stats.map((s, i) => (
          <div class="border-ink/10 py-10 even:border-l even:pl-6 [&:nth-child(n+3)]:border-t lg:border-l lg:px-8 lg:first:border-l-0 lg:first:pl-0 lg:[&:nth-child(n+3)]:border-t-0" data-reveal style={`--d:${i}`}>
            <dt class="eyebrow text-mute">{s.label}</dt>
            <dd class="mt-3 whitespace-nowrap font-wide text-[clamp(1.9rem,8vw,3rem)] font-extrabold tracking-tight text-signal">
              {'prefix' in s && s.prefix}<span data-count={s.value}>0</span><span class="text-gray">{s.suffix}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Valores -->
  <section class="on-dark bg-ink py-24 text-bone md:py-36">
    <div class="container-x">
      <Eyebrow index="02" class="mb-8 text-bone/50">Culture</Eyebrow>
      <SplitText text="What drives us." class="font-wide text-display font-extrabold uppercase" />
      <div class="mt-16 grid gap-px overflow-hidden rounded-sm bg-bone/10 md:grid-cols-2 lg:grid-cols-4">
        {
          values.map((v, i) => (
            <article class="group relative bg-ink p-8 transition-colors duration-500 hover:bg-steel md:p-10" data-reveal style={`--d:${i}`}>
              <p class="font-wide text-6xl font-extrabold text-signal/90">0{i + 1}</p>
              <h3 class="mt-16 font-semiwide text-2xl font-bold">{v.title}</h3>
              <p class="mt-4 text-bone/60">{v.text}</p>
              <span class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-signal transition-transform duration-700 ease-(--ease-expo) group-hover:scale-x-100" />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="py-24 md:py-36">
    <div class="container-x">
      <Eyebrow index="03" class="mb-8 text-mute">Milestones</Eyebrow>
      <SplitText text="Nearly four decades|of building." class="font-wide text-display font-extrabold uppercase" />
      <ol class="timeline relative mt-20 grid gap-12 sm:grid-cols-2 md:grid-cols-4 lg:gap-8 xl:grid-cols-7 xl:gap-6" data-reveal="fade">
        <span class="timeline-line absolute left-0 right-0 top-[0.55rem] hidden h-px origin-left bg-ink/20 xl:block"></span>
        {
          timeline.map((t, i) => (
            <li class="relative" data-reveal style={`--d:${i}`}>
              <span class="relative z-10 block size-3 rounded-full border-2 border-signal bg-bone" />
              <p class="mt-6 font-wide text-4xl font-extrabold tracking-tight">{t.year}</p>
              <p class="mt-3 font-semibold">{t.title}</p>
              <p class="mt-2 text-sm text-ink/60">{t.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Liderazgo -->
  <section class="bg-concrete py-24 md:py-36">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <div>
          <Eyebrow index="04" class="mb-8 text-mute">Leadership</Eyebrow>
          <SplitText text="The people|behind the work." class="font-wide text-title font-extrabold uppercase" />
        </div>
        <div data-reveal><Button href={u('/contact#careers')} variant="dark">Join our team</Button></div>
      </div>
      <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-10 md:mt-16 md:grid-cols-3 md:gap-x-6 md:gap-y-12">
        {
          leadership.map((p, i) => (
            <li class="group" data-reveal style={`--d:${i % 3}`}>
              <div class="relative aspect-[4/5] overflow-hidden rounded-sm bg-bone">
                <div class="bg-grid absolute inset-0 text-signal/60" />
                <svg viewBox="0 0 200 250" class="absolute inset-x-0 bottom-0 w-full text-gray/25 transition-transform duration-1000 ease-(--ease-expo) group-hover:scale-105" aria-hidden="true">
                  <circle cx="100" cy="95" r="42" fill="currentColor" />
                  <path d="M20 250c0-55 36-90 80-90s80 35 80 90z" fill="currentColor" />
                </svg>
                <span class="eyebrow absolute bottom-3 left-3 hidden text-mute sm:block">Portrait placeholder</span>
              </div>
              <p class="mt-4 font-semiwide text-base font-bold sm:text-xl md:mt-5">{p.name}</p>
              <p class="text-sm text-mute sm:text-base">{p.role}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Seguridad y sostenibilidad -->
  <section class="py-24 md:py-36">
    <div class="container-x grid gap-6 lg:grid-cols-2">
      <article id="safety" class="on-dark relative overflow-hidden rounded-sm bg-ink p-10 text-bone md:p-14" data-reveal>
        <p class="eyebrow text-signal">Health & safety</p>
        <h3 class="relative z-10 mt-6 font-wide text-4xl font-extrabold uppercase leading-none md:text-5xl">COR™ certified since 2015.</h3>
        <p class="relative z-10 mt-6 max-w-sm text-bone/65">During the COR audit process, overwhelming evidence of a strong safety culture was presented — all personnel expressed commitment to continual improvement, and senior management instills strong values into the fabric of our operation.</p>
        <svg viewBox="0 0 200 200" class="draw absolute -bottom-20 -right-20 w-64 text-signal/50" fill="none" aria-hidden="true">
          <path d="M100 20l70 30v50c0 45-30 75-70 90-40-15-70-45-70-90V50z" stroke="currentColor" stroke-width="1.5" pathLength="1" class="ln" />
          <path d="M70 105l20 20 40-45" stroke="currentColor" stroke-width="1.5" pathLength="1" class="ln" style="--i:10" />
        </svg>
      </article>
      <article id="recognition" class="relative overflow-hidden rounded-sm bg-concrete p-10 md:p-14" data-reveal style="--d:1">
        <p class="eyebrow text-signal-ink">Awards & recognition</p>
        <h3 class="relative z-10 mt-6 font-wide text-4xl font-extrabold uppercase leading-none md:text-5xl">Platinum. Best Managed.</h3>
        <p class="relative z-10 mt-6 max-w-sm text-ink/65">In 2021 Grascan reached Platinum status after 7 years as one of Canada’s Best Managed Companies, certified by Deloitte. Owner Angelo Grassa credits the work ethic, dedication and innovative mindset of Grascan’s employees.</p>
        <svg viewBox="0 0 200 200" class="draw absolute -bottom-20 -right-20 w-64 text-ink/25" fill="none" aria-hidden="true">
          <circle cx="100" cy="80" r="50" stroke="currentColor" stroke-width="1.5" pathLength="1" class="ln" />
          <path d="M75 120l-15 60 40-20 40 20-15-60" stroke="currentColor" stroke-width="1.5" pathLength="1" class="ln" style="--i:6" />
          <path d="M100 55l7 15 16 2-12 11 3 16-14-8-14 8 3-16-12-11 16-2z" stroke="currentColor" stroke-width="1.5" pathLength="1" class="ln" style="--i:10" />
        </svg>
      </article>
    </div>
  </section>

  <section class="overflow-hidden border-y border-ink/10 bg-concrete py-8" aria-label="Awards and certifications">
    <Marquee items={awards} class="eyebrow text-base text-signal" speed="45s" />
  </section>

  <EstimatingCTA />
</Base>
