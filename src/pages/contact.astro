---
import { u } from '@/lib/url';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import SplitText from '@/components/SplitText.astro';
import LocationsMap from '@/components/LocationsMap.astro';
import Icon from '@/components/Icon.astro';
import { site, offices } from '@/site.config';

const departments = [
  { id: 'general', title: 'General inquiries', text: 'Questions about our company, services or a potential project.', email: site.email },
  { id: 'estimating', title: 'Estimating & bids', text: 'Subcontractors and suppliers interested in bidding.', email: site.estimatingEmail, link: { href: '/estimating', label: 'Supplier registration' } },
  { id: 'careers', title: 'Careers', text: 'Build your career with a team that invests in its people.', email: 'careers@halden.example' },
  { id: 'media', title: 'Media', text: 'Press inquiries, interviews and media kit requests.', email: 'media@halden.example' },
];
const mapQuery = (o: (typeof offices)[number]) => `https://www.google.com/maps?q=${encodeURIComponent(o.address.join(', '))}&output=embed`;
---

<Base title="Contact" description={`Contact ${site.legalName}: offices in ${offices.map((o) => o.city).join(', ')}.`}>
  <PageHero index="07" eyebrow="Contact" title="Let's build|something." accent={['something.']} lead="Tell us about your project, ask a question or find the office nearest to you. We usually reply within one business day." />

  <!-- Formulario + departamentos -->
  <section class="py-20 md:py-28">
    <div class="container-x grid gap-16 lg:grid-cols-12">
      <form name="contact" method="POST" action={site.formEndpoint || u('/thanks')} data-netlify="true" netlify-honeypot="bot-field" class="lg:col-span-7">
        <input type="hidden" name="form-name" value="contact" />
        <p hidden><label>Don't fill this out: <input name="bot-field" /></label></p>
        <Eyebrow index="01" class="mb-8 text-mute">Send a message</Eyebrow>
        <div class="grid gap-8 md:grid-cols-2" data-reveal>
          <div class="field"><label class="field-label" for="c-name">Name *</label><input class="input" id="c-name" name="name" required autocomplete="name" /></div>
          <div class="field"><label class="field-label" for="c-company">Company</label><input class="input" id="c-company" name="company" autocomplete="organization" /></div>
          <div class="field"><label class="field-label" for="c-email">Email *</label><input class="input" id="c-email" name="email" type="email" required autocomplete="email" /></div>
          <div class="field"><label class="field-label" for="c-phone">Phone</label><input class="input" id="c-phone" name="phone" type="tel" autocomplete="tel" /></div>
          <fieldset class="md:col-span-2">
            <legend class="field-label mb-4">I'm interested in</legend>
            <div class="flex flex-wrap gap-2">
              {['A new project', 'Pre-construction', 'Bidding / suppliers', 'Careers', 'Media', 'Other'].map((t, i) => (
                <label class="chip"><input type="radio" name="topic" value={t} class="sr-only" checked={i === 0} />{t}</label>
              ))}
            </div>
          </fieldset>
          <div class="field md:col-span-2"><label class="field-label" for="c-message">Message *</label><textarea class="input" id="c-message" name="message" rows="5" required></textarea></div>
        </div>
        <div class="mt-10 flex flex-wrap items-center justify-between gap-6" data-reveal>
          <p class="max-w-sm text-sm text-mute">By submitting you agree to our <a href={u('/privacy')} class="underline underline-offset-4">privacy policy</a>.</p>
          <button type="submit" class="btn btn-primary">Send message <span class="btn-arrow"><Icon name="arrow" class="size-3.5" /></span></button>
        </div>
      </form>

      <aside class="lg:col-span-4 lg:col-start-9">
        <Eyebrow index="02" class="mb-8 text-mute">Departments</Eyebrow>
        <ul class="border-t border-ink/12">
          {
            departments.map((d, i) => (
              <li id={d.id} class="scroll-mt-28 border-b border-ink/12 py-6" data-reveal style={`--d:${i}`}>
                <p class="font-semiwide text-xl font-bold">{d.title}</p>
                <p class="mt-1 text-sm text-ink/60">{d.text}</p>
                <div class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm font-semibold">
                  <a class="link-u" href={`mailto:${d.email}`}>{d.email}</a>
                  {d.link && <a class="link-u text-signal" href={u(d.link.href)}>{d.link.label} →</a>}
                </div>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>

  <!-- Oficinas -->
  <section class="bg-ink py-20 text-bone md:py-28">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-5">
          <Eyebrow index="03" class="mb-8 text-bone/50">Our offices</Eyebrow>
          <SplitText text="Four offices.|One team." class="font-wide text-title font-extrabold uppercase" />
        </div>
        <div class="text-bone lg:col-span-7" data-reveal="fade"><LocationsMap /></div>
      </div>

      <div class="mt-16 grid gap-6 md:grid-cols-2">
        {
          offices.map((o, i) => (
            <article class="group overflow-hidden rounded-sm border border-white/10 bg-ink-2" data-reveal style={`--d:${i % 2}`}>
              <div class="relative aspect-[16/7] overflow-hidden bg-steel">
                <button type="button" class="absolute inset-0 flex h-full w-full items-center justify-center" data-map-src={mapQuery(o)} aria-label={`Load map for ${o.city} office`}>
                  <span class="bg-grid absolute inset-0 text-bone/40" />
                  <svg viewBox="0 0 400 175" class="absolute inset-0 h-full w-full text-bone/10" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                    <path d={`M0 ${60 + i * 10}H400M0 ${120 - i * 8}H400M${90 + i * 30} 0V175M${260 - i * 20} 0V175M0 175L${180 + i * 20} 0`} stroke="currentColor" stroke-width="6" fill="none" />
                  </svg>
                  <span class="relative flex flex-col items-center gap-3">
                    <span class="grid size-12 place-items-center rounded-full bg-signal text-ink shadow-[0_0_0_10px_rgb(255_79_23/.2)]"><Icon name="pin" class="size-5" /></span>
                    <span class="eyebrow rounded-full bg-ink/80 px-3 py-1.5 text-bone/80 transition-colors group-hover:text-bone">Click to load map</span>
                  </span>
                </button>
              </div>
              <div class="grid gap-6 p-8 sm:grid-cols-2">
                <div>
                  <p class="eyebrow text-signal">{o.label}</p>
                  <h3 class="mt-2 font-wide text-3xl font-extrabold uppercase">{o.city}</h3>
                  <p class="eyebrow mt-3 text-bone/40">{o.coords}</p>
                </div>
                <ul class="space-y-3 text-sm text-bone/75">
                  <li class="flex gap-3"><Icon name="pin" class="mt-0.5 size-4 shrink-0 text-signal" /><span>{o.address[0]}<br />{o.address[1]}</span></li>
                  <li class="flex gap-3"><Icon name="phone" class="mt-0.5 size-4 shrink-0 text-signal" /><a class="link-u" href={`tel:${o.phone.replace(/[^+\d]/g, '')}`}>{o.phone}</a></li>
                  <li class="flex gap-3"><Icon name="mail" class="mt-0.5 size-4 shrink-0 text-signal" /><a class="link-u" href={`mailto:${o.email}`}>{o.email}</a></li>
                  <li class="flex gap-3"><Icon name="clock" class="mt-0.5 size-4 shrink-0 text-signal" /><span>{o.hours}</span></li>
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Base>
