---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Media from '@/components/Media.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import SplitText from '@/components/SplitText.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/Button.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import VideoFacade from '@/components/VideoFacade.astro';
import Lightbox from '@/components/Lightbox.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length], all: projects },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
  all: CollectionEntry<'projects'>[];
}

const { project, next, all } = Astro.props;
const { Content } = await render(project);
const p = project.data;
const related = all.filter((x) => x.id !== project.id && x.data.sector === p.sector).slice(0, 2);
const more = related.length ? related : all.filter((x) => x.id !== project.id).slice(0, 2);

const facts = [
  { label: 'Client', value: p.client },
  { label: 'Location', value: p.location },
  { label: 'Sector', value: p.sector },
  { label: 'Delivery', value: p.delivery },
  { label: 'Value', value: p.value },
  { label: 'Size', value: p.size },
  { label: 'Status', value: p.status },
  { label: 'Year', value: String(p.year) },
].filter((f) => f.value);
---

<Base title={p.title} description={p.summary}>
  <!-- Hero de proyecto -->
  <section class="relative min-h-[92svh] overflow-hidden bg-ink text-bone">
    <div class="absolute inset-0">
      <Media src={p.cover} alt={p.title} seed={project.id} variant={p.variant} eager class="absolute inset-0" imgClass="parallax" sizes="100vw" />
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/40 to-ink/30"></div>
    </div>
    <div class="container-x relative flex min-h-[92svh] flex-col justify-end pb-14 pt-[calc(var(--header-h)+4rem)]">
      <a href="/projects" class="eyebrow mb-10 inline-flex items-center gap-3 text-bone/60 hover:text-bone" data-reveal>
        <Icon name="arrow-left" class="size-4" /> All projects
      </a>
      <div class="mb-6 flex flex-wrap gap-2" data-reveal style="--d:1">
        <span class="eyebrow rounded-full bg-bone px-3 py-1.5 text-ink">{p.sector}</span>
        <span class="eyebrow rounded-full border border-white/25 px-3 py-1.5">{p.location}</span>
        {p.status !== 'Completed' && <span class="eyebrow rounded-full bg-signal px-3 py-1.5 text-ink">{p.status}</span>}
      </div>
      <SplitText as="h1" text={p.title} class="max-w-5xl font-wide text-display font-extrabold uppercase" />
      <p class="mt-8 max-w-2xl text-lead text-bone/75" data-reveal style="--d:3">{p.summary}</p>
    </div>
  </section>

  <!-- Cifras clave -->
  {
    p.facts.length > 0 && (
      <section class="border-b border-ink/10">
        <dl class="container-x grid grid-cols-2 md:grid-cols-4">
          {p.facts.map((f, i) => (
            <div class="border-ink/10 py-10 max-md:[&:nth-child(n+3)]:border-t max-md:even:border-l max-md:even:pl-6 md:border-l md:px-8 md:first:border-l-0 md:first:pl-0" data-reveal style={`--d:${i}`}>
              <dd class="font-wide text-4xl font-extrabold tracking-tight md:text-5xl">{f.value}</dd>
              <dt class="eyebrow mt-3 text-mute">{f.label}</dt>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <!-- Contenido + ficha técnica -->
  <section class="py-20 md:py-32">
    <div class="container-x grid gap-16 lg:grid-cols-12">
      <aside class="lg:col-span-4">
        <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)]">
          <Eyebrow class="mb-6 text-mute">Project data</Eyebrow>
          <dl class="border-t border-ink/12">
            {
              facts.map((f, i) => (
                <div class="grid grid-cols-[7rem_1fr] gap-4 border-b border-ink/12 py-4" data-reveal style={`--d:${i}`}>
                  <dt class="eyebrow pt-1 text-mute">{f.label}</dt>
                  <dd class="font-medium">{f.value}</dd>
                </div>
              ))
            }
          </dl>
          {
            p.services.length > 0 && (
              <div class="mt-8 flex flex-wrap gap-2" data-reveal>
                {p.services.map((s) => <a href="/services" class="chip text-sm">{s}</a>)}
              </div>
            )
          }
          <div class="mt-10" data-reveal><Button href="/contact" variant="dark">Discuss a similar project</Button></div>
        </div>
      </aside>
      <article class="prose max-w-none lg:col-span-7 lg:col-start-6" data-reveal="fade">
        <Content />
      </article>
    </div>
  </section>

  <!-- Galería -->
  {
    p.gallery.length > 0 && (
      <section class="bg-ink py-20 text-bone md:py-32">
        <div class="container-x">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <div>
              <Eyebrow class="mb-6 text-bone/50">Gallery</Eyebrow>
              <SplitText text="On site." class="font-wide text-title font-extrabold uppercase" />
            </div>
            <p class="eyebrow text-bone/50">{p.gallery.length} images · click to enlarge</p>
          </div>
          <div class="mt-14 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
            {p.gallery.map((g, i) => (
              <button
                type="button"
                class:list={['group relative block overflow-hidden rounded-sm text-left', i % 5 === 0 ? 'col-span-2 row-span-2' : '']}
                data-lightbox="gallery"
                data-caption={g.caption}
                data-reveal="mask"
                style={`--d:${i % 4}`}
              >
                <Media src={g.src} alt={g.caption} seed={`${project.id}-${i}`} variant={g.variant} label={false} class:list={['h-full w-full', i % 5 === 0 ? 'aspect-square' : 'aspect-[4/3]']} imgClass="transition-transform duration-[1.2s] ease-(--ease-expo) group-hover:scale-105" sizes="(min-width: 768px) 50vw, 100vw" />
                <span class="absolute inset-x-3 bottom-3 flex items-center justify-between gap-3 rounded-sm bg-ink/70 px-3 py-2 text-sm opacity-0 backdrop-blur transition-opacity group-hover:opacity-100">
                  {g.caption}
                  <Icon name="plus" class="size-4" />
                </span>
              </button>
            ))}
          </div>
          {p.video && <div class="mt-14" data-reveal><VideoFacade embed={p.video} title={`${p.title} — Project film`} seed={`${project.id}-video`} variant={p.variant} /></div>}
        </div>
      </section>
    )
  }

  <!-- Siguiente proyecto -->
  <a href={`/projects/${next.id}`} class="group relative block overflow-hidden bg-signal text-ink">
    <div class="container-x relative flex flex-col gap-6 py-20 md:flex-row md:items-end md:justify-between md:py-28">
      <div>
        <p class="eyebrow">Next project</p>
        <p class="mt-4 font-wide text-display font-extrabold uppercase transition-transform duration-700 ease-(--ease-expo) group-hover:translate-x-4">{next.data.title}</p>
      </div>
      <span class="grid size-20 shrink-0 place-items-center rounded-full bg-ink text-signal transition-transform duration-700 ease-(--ease-expo) group-hover:-rotate-45">
        <Icon name="arrow" class="size-7" />
      </span>
    </div>
  </a>

  <section class="py-20 md:py-28">
    <div class="container-x">
      <Eyebrow class="mb-10 text-mute">More {related.length ? p.sector.toLowerCase() : ''} projects</Eyebrow>
      <div class="grid gap-x-8 gap-y-14 md:grid-cols-2">
        {more.map((x, i) => <ProjectCard project={x} index={i} />)}
      </div>
    </div>
  </section>

  <Lightbox />
</Base>
