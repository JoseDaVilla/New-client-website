---
import FilterBar from '@/components/FilterBar.astro';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import EstimatingCTA from '@/components/EstimatingCTA.astro';
import { sectors } from '@/site.config';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const used = sectors.filter((s) => projects.some((p) => p.data.sector === s));
const count = (s: string) => projects.filter((p) => p.data.sector === s).length;
---

<Base title="Projects" description="Grascan projects: bridges and structures, rail and transit, roads and highways and infrastructure across Southern Ontario.">
  <PageHero
    index="03"
    eyebrow="Projects"
    title="Projects that|move Ontario."
    lead="Time-sensitive, complicated and high-profile — a selection of projects that have cemented Grascan’s legacy across Southern Ontario."
  />

  <section class="py-16 md:py-24">
    <div class="container-x">
      <FilterBar target="project-grid" label="Filter by sector" sticky allCount={projects.length} items={used.map((s) => ({ value: s, label: s, count: count(s) }))} class="mb-10 md:mb-14" />

      <div id="project-grid" class="grid gap-x-8 gap-y-16 md:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((p, i) => (
            <div class:list={[i % 7 === 0 && 'md:col-span-2']} data-tags={`${p.data.sector}`} style={`view-transition-name: p-${p.id}`}>
              <ProjectCard project={p} index={i} size={i % 7 === 0 ? 'lg' : 'md'} eager={i < 2} />
            </div>
          ))
        }
      </div>
      <p class="py-20 text-center text-mute" data-filter-empty hidden>No projects in this sector yet.</p>
    </div>
  </section>

  <EstimatingCTA />
</Base>
