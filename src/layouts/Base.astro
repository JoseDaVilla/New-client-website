---
import { u } from '@/lib/url';
import '@/styles/global.css';
import archivoUrl from '@/assets/fonts/archivo.woff2?url';
import { site } from '@/site.config';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Intro from '@/components/Intro.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  intro?: boolean;
  noindex?: boolean;
}

const { title, description = site.description, image = '/og.png', intro = false, noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.legalName}` : `${site.legalName} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(u(image), Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: site.legalName,
  url: Astro.site?.toString(),
  email: site.email,
  telephone: site.phone,
  foundingDate: String(site.founded),
};
---

<!doctype html>
<html lang="en" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b0d10" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={u('/sitemap-index.xml')} />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Antes del primer paint: activa animaciones JS y decide si mostrar la intro -->
    <script is:inline define:vars={{ intro }}>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if (!intro) return;
        try {
          var force = /[?&]intro\b/.test(location.search);
          var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          if ((force || !sessionStorage.getItem('intro-seen')) && !reduce) {
            d.classList.add('has-intro');
            sessionStorage.setItem('intro-seen', '1');
            setTimeout(function () { d.classList.add('intro-done'); }, 2700);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-dvh overflow-x-clip">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:rounded-full focus:bg-signal focus:px-5 focus:py-3 focus:text-ink">Skip to content</a>
    {intro && <Intro />}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
