---
interface Props { index?: string; class?: string }
const { index, class: cls = '' } = Astro.props;
// Sobre fondo claro se usa el naranja oscuro para cumplir contraste AA
const onDark = /text-bone/.test(cls);
---
<p class:list={['eyebrow flex items-center gap-3', cls]}>
  {index && <span class={onDark ? 'text-signal' : 'text-signal-ink'}>{index}</span>}
  <span class="h-px w-8 bg-current opacity-40"></span>
  <span><slot /></span>
</p>
