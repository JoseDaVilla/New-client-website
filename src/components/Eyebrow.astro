---
interface Props { index?: string; class?: string }
const { index, class: cls = '' } = Astro.props;
---
<p class:list={['eyebrow flex items-center gap-3', cls]}>
  {index && <span class="text-signal">{index}</span>}
  <span class="h-px w-8 bg-current opacity-40"></span>
  <span><slot /></span>
</p>
