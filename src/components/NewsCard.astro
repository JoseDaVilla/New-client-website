---
import { u } from '@/lib/url';
import type { CollectionEntry } from 'astro:content';
import Media from './Media.astro';
interface Props { post: CollectionEntry<'news'>; index?: number; feature?: boolean }
const { post, index = 0, feature = false } = Astro.props;
const d = post.data;
const date = d.date.toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<a href={u(`/news/${post.id}`)} class:list={['group block', feature && 'md:grid md:grid-cols-12 md:items-end md:gap-10']} data-reveal style={`--d:${index % 3}`}>
  <Media
    src={d.cover}
    alt={d.title}
    seed={post.id}
    variant={d.variant}
    tone="light"
    label={false}
    class:list={[feature ? 'aspect-[16/10] md:col-span-7' : 'aspect-[16/10]']}
    imgClass="transition-transform duration-[1.4s] ease-(--ease-expo) group-hover:scale-[1.05]"
    sizes="(min-width: 1024px) 33vw, 100vw"
  />
  <div class:list={['mt-5 border-t border-ink/10 pt-4', feature && 'md:col-span-5 md:mt-0 md:border-t-0 md:pt-0']}>
    <p class="text-sm text-mute"><span class="font-semibold text-signal-ink">{d.category}</span>, <time datetime={d.date.toISOString()}>{date}</time></p>
    <h3 class:list={['mt-2 font-semiwide font-bold leading-[1.15] tracking-tight text-ink', feature ? 'text-3xl md:text-5xl' : 'text-xl md:text-2xl']}>
      <span class="group-hover:underline group-hover:decoration-2 group-hover:underline-offset-4">{d.title}</span>
    </h3>
    {feature && <p class="mt-5 max-w-md text-lg text-ink/70">{d.excerpt}</p>}
  </div>
</a>
