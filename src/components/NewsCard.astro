---
import { u } from '@/lib/url';
import type { CollectionEntry } from 'astro:content';
import Media from './Media.astro';
interface Props { post: CollectionEntry<'news'>; index?: number; feature?: boolean }
const { post, index = 0, feature = false } = Astro.props;
const d = post.data;
const date = d.date.toLocaleDateString('en-CA', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<a href={u(`/news/${post.id}`)} class:list={['group block', feature && 'md:grid md:grid-cols-12 md:items-end md:gap-10']} data-reveal style={`--d:${index % 3}`}>
  <Media
    src={d.cover}
    alt={d.title}
    seed={post.id}
    variant={d.variant}
    tone="light"
    label={false}
    class:list={['rounded-sm', feature ? 'aspect-[16/10] md:col-span-7' : 'aspect-[16/10]']}
    imgClass="transition-transform duration-[1.4s] ease-(--ease-expo) group-hover:scale-[1.05]"
    sizes="(min-width: 1024px) 33vw, 100vw"
  />
  <div class:list={['mt-6', feature && 'md:col-span-5 md:mt-0']}>
    <p class="eyebrow flex items-center gap-3 text-mute">
      <span class="text-signal-ink">{d.category}</span><span class="h-px w-6 bg-current"></span><time datetime={d.date.toISOString()}>{date}</time>
    </p>
    <h3 class:list={['mt-4 font-semiwide font-bold leading-[1.1] tracking-tight', feature ? 'text-3xl md:text-5xl' : 'text-2xl']}>
      <span class="link-u">{d.title}</span>
    </h3>
    {feature && <p class="mt-5 max-w-md text-lg text-ink/70">{d.excerpt}</p>}
  </div>
</a>
