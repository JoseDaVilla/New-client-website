---
import Button from './Button.astro';
import SplitText from './SplitText.astro';
import { bids } from '@/data/services';
---
<section class="relative overflow-hidden bg-signal text-ink">
  <svg class="draw pointer-events-none absolute inset-0 h-full w-full text-ink/15" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMid slice" fill="none" aria-hidden="true">
    {Array.from({ length: 12 }, (_, i) => <path d={`M${-200 + i * 140} 600L${300 + i * 140} 0`} stroke="currentColor" pathLength="1" class="ln" style={`--i:${i}`} />)}
    <circle cx="1180" cy="300" r="220" stroke="currentColor" stroke-width="1.5" pathLength="1" class="ln" style="--i:6" />
    <circle cx="1180" cy="300" r="140" stroke="currentColor" pathLength="1" class="ln" style="--i:8" />
  </svg>
  <div class="container-x relative grid gap-12 py-24 md:py-32 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-12">
      <p class="eyebrow mb-6">Trade partners & suppliers</p>
      <SplitText text="Bid with us.|Build with us." class="font-wide text-display font-extrabold uppercase" />
    </div>
    <div class="lg:col-span-6 lg:col-start-7" data-reveal style="--d:3">
      <p class="text-lead">We're always looking for qualified subcontractors and suppliers. Register your company, view open tenders and get invited to bid on upcoming work.</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <Button href="/estimating#register" variant="dark">Register as a supplier</Button>
        <a href="/estimating#opportunities" class="link-u font-semibold">{bids.length} open opportunities</a>
      </div>
    </div>
  </div>
</section>
