---
/**
 * Escena SVG animada del hero: torre en construcción + grúa torre con carga.
 * Se reemplaza por vídeo pasando `video` al componente <Hero />.
 */
const G = 820; // suelo
const floors = 14;
const fh = 38;
const bx = 900;
const bw = 280;
const top = G - floors * fh;
const skyline = [
  [40, 600, 110], [160, 660, 80], [250, 540, 120], [380, 700, 70], [460, 610, 95], [570, 680, 90], [670, 570, 70], [1180, 640, 110], [1300, 700, 140],
];
let i = 0;
const n = () => `--i:${i++}`;
---

<svg viewBox="0 0 1440 900" preserveAspectRatio="xMaxYMax slice" class="hero-scene draw absolute inset-0 h-full w-full" style="--base: var(--intro-delay, 0ms)" aria-hidden="true" fill="none" stroke-linecap="square">
  <!-- Skyline lejano -->
  <g stroke="rgb(246 245 241 / .1)" stroke-width="1">
    {skyline.map(([x, y, w]) => <path d={`M${x} ${G}V${y}H${x + w}V${G}`} pathLength="1" class="ln" style={n()} />)}
  </g>

  <!-- Suelo -->
  <path d={`M0 ${G}H1440`} stroke="rgb(246 245 241 / .5)" stroke-width="1.5" pathLength="1" class="ln" style="--i:0" />
  <g stroke="rgb(246 245 241 / .12)">
    {Array.from({ length: 90 }, (_, k) => <path d={`M${k * 16} ${G + 2}l-10 10`} />)}
  </g>

  <!-- Torre: plantas construyéndose de abajo hacia arriba -->
  <g stroke="rgb(246 245 241 / .75)" stroke-width="1.5">
    <path d={`M${bx} ${G}V${top}M${bx + bw} ${G}V${top}`} pathLength="1" class="ln" style={n()} />
    {Array.from({ length: floors }, (_, f) => (
      <path d={`M${bx - 8} ${G - (f + 1) * fh}H${bx + bw + 8}`} pathLength="1" class="ln" style={`--i:${6 + f}`} />
    ))}
  </g>
  <g stroke="rgb(246 245 241 / .22)" stroke-width="1">
    {[1, 2, 3, 4, 5].map((c) => <path d={`M${bx + (bw / 6) * c} ${G}V${top}`} pathLength="1" class="ln" style={`--i:${8 + c}`} />)}
  </g>
  <!-- Paneles de fachada (acento) -->
  <g class="draw-fill">
    {[2, 5, 6, 9].map((f, k) => (
      <rect x={bx + (bw / 6) * ((k * 2 + 1) % 6)} y={G - (f + 1) * fh} width={bw / 6} height={fh} fill="rgb(255 79 23 / .2)" stroke="var(--color-signal)" stroke-width="1" vector-effect="non-scaling-stroke" />
    ))}
  </g>
  <!-- Plantas futuras (punteadas) -->
  <g stroke="rgb(246 245 241 / .25)" stroke-dasharray="4 6" stroke-width="1">
    <path d={`M${bx + 20} ${top}V${top - 3 * fh}H${bx + bw - 20}V${top}M${bx + 20} ${top - fh}H${bx + bw - 20}M${bx + 20} ${top - 2 * fh}H${bx + bw - 20}`} vector-effect="non-scaling-stroke" />
  </g>

  <!-- Cotas -->
  <g stroke="rgb(246 245 241 / .3)" stroke-width="1">
    <path d={`M${bx - 60} ${G}V${top}M${bx - 66} ${G}h12M${bx - 66} ${top}h12`} pathLength="1" class="ln" style="--i:22" />
  </g>
  <g font-family="JetBrains Mono, monospace" font-size="12" letter-spacing="1.5" fill="rgb(246 245 241 / .45)" class="draw-fill" style="--i:20">
    <text x={bx - 74} y={(G + top) / 2} transform={`rotate(-90 ${bx - 74} ${(G + top) / 2})`} text-anchor="middle">+168.00 M</text>
    <text x={bx + bw + 24} y={top + 4}>L46</text>
    <text x={bx + bw + 24} y={G - 6 * fh + 4}>L24</text>
    <text x={bx + bw + 24} y={G - 4}>L00</text>
  </g>

  <!-- Grúa torre -->
  <g stroke="var(--color-signal)" stroke-width="2">
    <path d={`M1240 ${G}V140M1262 ${G}V140`} pathLength="1" class="ln" style="--i:4" />
    <path d="M900 140H1420M900 128H1240M1262 128H1420" pathLength="1" class="ln" style="--i:10" />
    <path d="M1251 70L900 128M1251 70L1420 128M1251 70V140" pathLength="1" class="ln" style="--i:12" />
  </g>
  <g stroke="rgb(255 79 23 / .5)" stroke-width="1">
    {Array.from({ length: 30 }, (_, k) => <path d={`M1240 ${G - k * 23}l22 -23`} />)}
    {Array.from({ length: 22 }, (_, k) => <path d={`M${910 + k * 23} 140l11 -12l12 12`} />)}
  </g>
  <rect x="1380" y="142" width="40" height="26" fill="var(--color-signal)" class="draw-fill" style="--i:14" />
  <rect x="1226" y="140" width="22" height="20" fill="rgb(246 245 241 / .9)" class="draw-fill" style="--i:14" />

  <!-- Carro + cable + carga (animación continua) -->
  <g class="draw-fill" style="--i:18"><g class="trolley">
    <rect x="-12" y="140" width="24" height="8" fill="var(--color-bone)" />
    <g class="hoist">
      <path class="cable" d="M0 148V430" stroke="rgb(246 245 241 / .6)" stroke-width="1" vector-effect="non-scaling-stroke" />
      <g class="load">
        <path d="M0 430l-40 22M0 430l40 22" stroke="rgb(246 245 241 / .6)" stroke-width="1" vector-effect="non-scaling-stroke" />
        <rect x="-70" y="452" width="140" height="14" fill="var(--color-signal)" />
        <path d="M-70 459h140" stroke="var(--color-ink)" stroke-width="1" />
      </g>
    </g>
  </g></g>

  <!-- Marcas de replanteo -->
  <g stroke="rgb(246 245 241 / .35)" stroke-width="1" class="draw-fill" style="--i:24">
    <circle cx={bx} cy={G} r="10" /><path d={`M${bx - 16} ${G}h32M${bx} ${G - 16}v32`} />
    <circle cx={bx + bw} cy={G} r="10" /><path d={`M${bx + bw - 16} ${G}h32M${bx + bw} ${G - 16}v32`} />
  </g>
</svg>

<style>
  .hero-scene {
    --loop-delay: calc(var(--base, 0ms) + 1.8s);
  }
  .trolley,
  .cable,
  .load {
    animation-duration: 14s;
    animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
    animation-iteration-count: infinite;
    animation-delay: var(--loop-delay);
  }
  .trolley {
    transform: translateX(1010px);
    animation-name: trolley;
  }
  .cable {
    transform-origin: 0 148px;
    animation-name: cable;
  }
  .load {
    transform-box: fill-box;
    transform-origin: 50% 0;
    animation-name: load;
  }
  @keyframes trolley {
    0%, 8% { transform: translateX(1010px); }
    42%, 58% { transform: translateX(1150px); }
    92%, 100% { transform: translateX(1010px); }
  }
  @keyframes cable {
    0%, 8% { transform: scaleY(1); }
    30%, 70% { transform: scaleY(0.55); }
    92%, 100% { transform: scaleY(1); }
  }
  @keyframes load {
    0%, 8% { transform: translateY(0) rotate(0deg); }
    30% { transform: translateY(-127px) rotate(1.5deg); }
    50% { transform: translateY(-127px) rotate(-1deg); }
    70% { transform: translateY(-127px) rotate(0.5deg); }
    92%, 100% { transform: translateY(0) rotate(0deg); }
  }
</style>
