---
/**
 * Vídeo de YouTube/Vimeo sin coste de carga: sólo se inserta el iframe al hacer clic.
 * `embed` = URL de embed (p. ej. https://www.youtube-nocookie.com/embed/ID).
 */
import Media from './Media.astro';
import type { ImageMetadata } from 'astro';
import type { BlueprintVariant } from '@/lib/blueprint';
interface Props { embed?: string; title: string; poster?: ImageMetadata; seed?: string; variant?: BlueprintVariant; class?: string; duration?: string }
const { embed = 'https://www.youtube-nocookie.com/embed/VIDEO_ID', title, poster, seed = title, variant, class: cls = '', duration } = Astro.props;
---
<div class:list={['on-dark relative aspect-video overflow-hidden bg-ink', cls]}>
  <button type="button" class="group absolute inset-0 h-full w-full text-left" data-video-facade={embed} aria-label={`Play video: ${title}`}>
    <Media src={poster} seed={seed} variant={variant} tone="dark" class="absolute inset-0" alt="" label={false} imgClass="transition-transform duration-[1.4s] ease-(--ease-expo) group-hover:scale-[1.03]" />
    <span class="absolute inset-x-0 bottom-0 flex items-stretch bg-ink">
      <span class="grid w-14 shrink-0 place-items-center bg-signal text-on-signal transition-colors group-hover:bg-bone group-hover:text-ink md:w-20">
        <svg viewBox="0 0 24 24" class="ml-0.5 size-5 md:size-6" aria-hidden="true"><path d="M7 4.5v15L20 12z" fill="currentColor" /></svg>
      </span>
      <span class="flex flex-1 items-center justify-between gap-4 px-4 py-3 text-bone md:px-6 md:py-5">
        <span class="font-semiwide text-sm font-bold leading-tight sm:text-base md:text-xl">{title}</span>
        {duration && <span class="text-sm text-bone/60">{duration}</span>}
      </span>
    </span>
  </button>
</div>
