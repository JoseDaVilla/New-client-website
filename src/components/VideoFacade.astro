---
/**
 * Vídeo de YouTube/Vimeo sin coste de carga: sólo se inserta el iframe al hacer clic.
 * `embed` = URL de embed (p. ej. https://www.youtube-nocookie.com/embed/ID).
 */
import Media from './Media.astro';
import type { ImageMetadata } from 'astro';
import type { BlueprintVariant } from '@/lib/blueprint';
interface Props { embed?: string; title: string; poster?: ImageMetadata; seed?: string; variant?: BlueprintVariant; class?: string; duration?: string }
const { embed = 'https://www.youtube-nocookie.com/embed/VIDEO_ID', title, poster, seed = title, variant, class: cls = '', duration } = Astro.props;
---
<div class:list={['relative aspect-video overflow-hidden rounded-sm bg-ink', cls]}>
  <button type="button" class="group absolute inset-0 h-full w-full text-left" data-video-facade={embed} aria-label={`Play video: ${title}`}>
    <Media src={poster} seed={seed} variant={variant} class="absolute inset-0" alt="" label={false} imgClass="transition-transform duration-[1.4s] ease-(--ease-expo) group-hover:scale-105" />
    <span class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/10 to-transparent"></span>
    <span class="absolute left-1/2 top-1/2 grid size-20 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-signal text-ink transition-transform duration-500 ease-(--ease-expo) group-hover:scale-110 md:size-24">
      <span class="absolute inset-0 animate-ping rounded-full bg-signal/40 [animation-duration:2.4s]"></span>
      <svg viewBox="0 0 24 24" class="relative ml-1 size-7" aria-hidden="true"><path d="M7 4.5v15L20 12z" fill="currentColor" /></svg>
    </span>
    <span class="absolute bottom-5 left-5 right-5 flex items-end justify-between gap-4 text-bone">
      <span class="font-semiwide text-xl font-bold md:text-2xl">{title}</span>
      {duration && <span class="eyebrow text-bone/70">{duration}</span>}
    </span>
  </button>
</div>
