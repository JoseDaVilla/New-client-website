---
/**
 * Animación de intro: retícula de plano + marca que se dibuja + contador.
 * 100% CSS. Se muestra una vez por sesión (o forzada con ?intro en la URL),
 * se puede saltar con clic / tecla, y respeta prefers-reduced-motion.
 */
import { site } from '@/site.config';
const letters = site.name.toUpperCase().split('');
---

<div id="intro" class="intro" aria-hidden="true">
  <div class="intro-layer intro-layer--accent"></div>
  <div class="intro-layer intro-layer--main">
    <div class="intro-grid">
      <span style="--x:20%"></span><span style="--x:40%"></span><span style="--x:60%"></span><span style="--x:80%"></span>
      <i style="--y:25%"></i><i style="--y:50%"></i><i style="--y:75%"></i>
    </div>

    <div class="intro-meta eyebrow">
      <span class="intro-tl">{site.legalName}</span>
      <span class="intro-tr">43.6453° N — 79.3806° W</span>
      <span class="intro-bl">Loading <b class="intro-count"></b>%</span>
      <span class="intro-br">Est. {site.founded}</span>
    </div>

    <div class="intro-center">
      <svg viewBox="0 0 120 120" class="intro-mark" fill="none" stroke-linecap="square">
        <circle cx="60" cy="60" r="56" stroke-width="1" pathLength="1" class="ln stroke-bone/14" style="--i:0" />
        <path d="M4 60h112M60 4v112" stroke-width="1" pathLength="1" class="ln stroke-bone/14" style="--i:1" />
        <path d="M32 104V16" stroke-width="12" pathLength="1" class="ln stroke-bone" style="--i:3" />
        <path d="M88 104V16" stroke-width="12" pathLength="1" class="ln stroke-bone" style="--i:4" />
        <path d="M32 60h56" stroke-width="12" pathLength="1" class="ln stroke-signal" style="--i:8" />
        <path d="M32 16h10M78 16h10M32 104h10M78 104h10" stroke-width="3" pathLength="1" class="ln stroke-bone" style="--i:10" />
      </svg>
      <p class="intro-word font-wide">
        {letters.map((l, i) => <span style={`--i:${i}`}>{l}</span>)}
      </p>
    </div>
  </div>
</div>

<style is:global>
  @property --intro-n {
    syntax: "<integer>";
    inherits: false;
    initial-value: 0;
  }
  .intro {
    display: none;
  }
  html.has-intro .intro {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: auto;
    animation: intro-hide 0s linear 3.1s forwards;
  }
  html.has-intro {
    --intro-delay: 2250ms;
  }
  html.has-intro:not(.intro-done) {
    overflow: hidden;
  }
  html.intro-skip .intro {
    animation: intro-hide 0s linear 0.6s forwards;
  }
  html.intro-skip .intro-layer {
    animation: intro-wipe 0.6s cubic-bezier(0.76, 0, 0.24, 1) forwards !important;
  }
  @keyframes intro-hide {
    to {
      visibility: hidden;
      pointer-events: none;
    }
  }
  .intro-layer {
    position: absolute;
    inset: 0;
    animation: intro-wipe 1s cubic-bezier(0.76, 0, 0.24, 1) forwards;
  }
  .intro-layer--accent {
    background: var(--color-signal);
    animation-delay: 2.2s;
  }
  .intro-layer--main {
    background: var(--color-ink);
    color: var(--color-bone);
    animation-delay: 2s;
  }
  @keyframes intro-wipe {
    to {
      clip-path: inset(0 0 100% 0);
    }
  }
  .intro-grid span,
  .intro-grid i {
    position: absolute;
    background: color-mix(in oklab, var(--color-bone) 8%, transparent);
  }
  .intro-grid span {
    top: 0;
    bottom: 0;
    left: var(--x);
    width: 1px;
    transform: scaleY(0);
    transform-origin: top;
    animation: intro-grow 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .intro-grid i {
    left: 0;
    right: 0;
    top: var(--y);
    height: 1px;
    transform: scaleX(0);
    transform-origin: left;
    animation: intro-grow 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
  }
  @keyframes intro-grow {
    to {
      transform: none;
    }
  }
  .intro-meta > span {
    position: absolute;
    opacity: 0;
    color: color-mix(in oklab, var(--color-bone) 60%, transparent);
    animation: intro-fade 0.8s ease 0.3s forwards;
  }
  .intro-tl { top: 1.5rem; left: 1.5rem; }
  .intro-tr { top: 1.5rem; right: 1.5rem; display: none; }
  @media (min-width: 640px) { .intro-tr { display: block; } }
  .intro-bl { bottom: 1.5rem; left: 1.5rem; }
  .intro-br { bottom: 1.5rem; right: 1.5rem; }
  .intro-count {
    font-weight: 500;
    color: var(--color-bone);
    counter-reset: n var(--intro-n);
    animation: intro-count 1.7s cubic-bezier(0.65, 0, 0.35, 1) 0.2s forwards;
  }
  .intro-count::after {
    content: counter(n);
  }
  @keyframes intro-count {
    to {
      --intro-n: 100;
    }
  }
  @keyframes intro-fade {
    to {
      opacity: 1;
    }
  }
  .intro-center {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.75rem;
    animation: intro-out 0.6s cubic-bezier(0.76, 0, 0.24, 1) 1.85s forwards;
  }
  @keyframes intro-out {
    to {
      opacity: 0;
      transform: translateY(-40px);
    }
  }
  .intro-mark {
    width: clamp(6rem, 16vw, 9rem);
  }
  .intro-mark .ln {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--i) * 70ms + 150ms);
  }
  .intro-word {
    display: flex;
    overflow: hidden;
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.08em;
  }
  .intro-word span {
    display: inline-block;
    transform: translateY(110%);
    animation: intro-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(0.75s + var(--i) * 55ms);
  }
  @keyframes intro-up {
    to {
      transform: none;
    }
  }
</style>
