---
/**
 * Animación de intro: fondo blanco, retícula de plano y el logo Grascan Build
 * construyéndose (las torres crecen desde la base, el wordmark se revela).
 * 100% CSS. Una vez por sesión (o forzada con ?intro), se puede saltar con clic / tecla,
 * y respeta prefers-reduced-motion.
 */
import { site } from '@/site.config';
import Logo from './Logo.astro';
---

<div id="intro" class="intro" aria-hidden="true">
  <div class="intro-layer intro-layer--accent"></div>
  <div class="intro-layer intro-layer--main">
    <div class="intro-grid">
      <span style="--x:20%"></span><span style="--x:40%"></span><span style="--x:60%"></span><span style="--x:80%"></span>
      <i style="--y:25%"></i><i style="--y:50%"></i><i style="--y:75%"></i>
    </div>

    <div class="intro-meta eyebrow">
      <span class="intro-tl">{site.legalName}</span>
      <span class="intro-tr">43.7440° N — 79.5940° W</span>
      <span class="intro-bl">Loading <b class="intro-count"></b>%</span>
      <span class="intro-br">Since {site.founded}</span>
    </div>

    <div class="intro-center">
      <span class="intro-ground"></span>
      <Logo variant="full" animate delay={250} class="intro-logo" />
    </div>
  </div>
</div>

<style is:global>
  @property --intro-n {
    syntax: "<integer>";
    inherits: false;
    initial-value: 0;
  }
  .intro {
    display: none;
  }
  html.has-intro .intro {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: auto;
    animation: intro-hide 0s linear 3.3s forwards;
  }
  html.has-intro {
    --intro-delay: 2450ms;
  }
  html.has-intro:not(.intro-done) {
    overflow: hidden;
  }
  html.intro-skip .intro {
    animation: intro-hide 0s linear 0.6s forwards;
  }
  html.intro-skip .intro-layer {
    animation: intro-wipe 0.6s cubic-bezier(0.76, 0, 0.24, 1) forwards !important;
  }
  @keyframes intro-hide {
    to {
      visibility: hidden;
      pointer-events: none;
    }
  }
  .intro-layer {
    position: absolute;
    inset: 0;
    animation: intro-wipe 1s cubic-bezier(0.76, 0, 0.24, 1) forwards;
  }
  .intro-layer--accent {
    background: var(--color-signal);
    animation-delay: 2.4s;
  }
  .intro-layer--main {
    background: var(--color-bone);
    color: var(--color-ink);
    animation-delay: 2.2s;
  }
  @keyframes intro-wipe {
    to {
      clip-path: inset(0 0 100% 0);
    }
  }
  .intro-grid span,
  .intro-grid i {
    position: absolute;
    background: color-mix(in oklab, var(--color-signal) 8%, transparent);
  }
  .intro-grid span {
    top: 0;
    bottom: 0;
    left: var(--x);
    width: 1px;
    transform: scaleY(0);
    transform-origin: top;
    animation: intro-grow 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .intro-grid i {
    left: 0;
    right: 0;
    top: var(--y);
    height: 1px;
    transform: scaleX(0);
    transform-origin: left;
    animation: intro-grow 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
  }
  @keyframes intro-grow {
    to {
      transform: none;
    }
  }
  .intro-meta > span {
    position: absolute;
    opacity: 0;
    color: var(--color-mute);
    animation: intro-fade 0.8s ease 0.3s forwards;
  }
  .intro-tl { top: 1.5rem; left: 1.5rem; }
  .intro-tr { top: 1.5rem; right: 1.5rem; display: none; }
  @media (min-width: 640px) { .intro-tr { display: block; } }
  .intro-bl { bottom: 1.5rem; left: 1.5rem; }
  .intro-br { bottom: 1.5rem; right: 1.5rem; }
  .intro-count {
    font-weight: 500;
    color: var(--color-signal);
    counter-reset: n var(--intro-n);
    animation: intro-count 1.9s cubic-bezier(0.65, 0, 0.35, 1) 0.2s forwards;
  }
  .intro-count::after {
    content: counter(n);
  }
  @keyframes intro-count {
    to {
      --intro-n: 100;
    }
  }
  @keyframes intro-fade {
    to {
      opacity: 1;
    }
  }
  .intro-center {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    animation: intro-out 0.6s cubic-bezier(0.76, 0, 0.24, 1) 2.05s forwards;
  }
  .intro-logo {
    width: clamp(11rem, 34vw, 19rem);
  }
  /* línea de "terreno" bajo las torres */
  .intro-ground {
    position: absolute;
    left: 50%;
    top: calc(50% + clamp(11rem, 34vw, 19rem) * 0.276);
    width: clamp(14rem, 44vw, 24rem);
    height: 1px;
    background: color-mix(in oklab, var(--color-signal) 30%, transparent);
    transform: translateX(-50%) scaleX(0);
    animation: intro-grow-x 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards;
  }
  @keyframes intro-grow-x {
    to {
      transform: translateX(-50%) scaleX(1);
    }
  }
  @keyframes intro-out {
    to {
      opacity: 0;
      transform: translateY(-40px);
    }
  }
</style>
