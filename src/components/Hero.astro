---
import { site, sectors } from '@/site.config';
import HeroScene from './HeroScene.astro';
import SplitText from './SplitText.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';

interface Props {
  /** Vídeo de fondo opcional (mp4/webm en /public). Si no se pasa, se usa la escena SVG. */
  video?: { src: string; poster?: string };
  featured?: { title: string; href: string; meta: string };
}
const { video, featured } = Astro.props;
---

<section class="hero relative flex min-h-[100svh] flex-col overflow-hidden bg-ink text-bone" style="--intro: var(--intro-delay, 0ms)">
  <div class="bg-grid pointer-events-none absolute inset-0 text-bone/50"></div>

  {
    video ? (
      <video class="absolute inset-0 h-full w-full object-cover opacity-60" autoplay muted loop playsinline preload="metadata" poster={video.poster}>
        <source src={video.src} type="video/mp4" />
      </video>
    ) : (
      <div class="absolute inset-0 max-lg:opacity-45">
        <HeroScene />
      </div>
    )
  }
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_20%_80%,rgb(11_13_16/.95),rgb(11_13_16/.5)_45%,transparent_75%)]"></div>

  <div class="container-x relative flex flex-1 flex-col justify-end pt-[calc(var(--header-h)+4rem)] pb-10 md:pb-14">
    <p class="hero-fade eyebrow mb-8 flex items-center gap-3 text-bone/60" style="--k:0">
      <span class="relative flex size-2"><span class="absolute inset-0 animate-ping rounded-full bg-signal"></span><span class="relative size-2 rounded-full bg-signal"></span></span>
      Now building across Canada
    </p>

    <SplitText
      as="h1"
      text="We build|what moves|cities forward."
      accent={['forward.']}
      afterIntro
      delay={150}
      class="font-wide text-[clamp(2.75rem,7.2vw,8rem)] leading-[0.88] tracking-[-0.035em] font-extrabold uppercase"
    />

    <div class="mt-10 grid gap-10 md:mt-14 lg:grid-cols-12 lg:items-end">
      <div class="hero-fade lg:col-span-5" style="--k:1">
        <p class="max-w-md text-lead text-bone/75">{site.description}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/projects">Explore our work</Button>
          <Button href="/estimating" variant="ghost-light">Bid opportunities</Button>
        </div>
      </div>

      <div class="hero-fade flex flex-col gap-6 lg:col-span-7 lg:items-end" style="--k:2">
        {
          featured && (
            <a href={featured.href} class="group flex w-full max-w-sm items-center gap-5 rounded-sm border border-white/12 bg-ink/50 p-4 backdrop-blur-md transition-colors hover:border-signal">
              <span class="grid size-14 shrink-0 place-items-center bg-signal text-ink">
                <Icon name="arrow" class="size-5 -rotate-45 transition-transform duration-500 ease-(--ease-expo) group-hover:rotate-0" />
              </span>
              <span>
                <span class="eyebrow block text-bone/50">Featured project</span>
                <span class="mt-1 block font-semibold">{featured.title}</span>
                <span class="block text-sm text-bone/50">{featured.meta}</span>
              </span>
            </a>
          )
        }
      </div>
    </div>
  </div>

  <!-- Barra inferior: sectores en loop -->
  <div class="hero-fade relative border-t border-white/10" style="--k:3">
    <div class="container-x flex items-center gap-8 py-4">
      <a href="#discover" class="eyebrow flex shrink-0 items-center gap-3 text-bone/60 hover:text-bone">
        <span class="scroll-cue relative block h-8 w-5 rounded-full border border-current"><span class="absolute left-1/2 top-1.5 h-1.5 w-0.5 -translate-x-1/2 rounded bg-signal"></span></span>
        Scroll
      </a>
      <div class="marquee eyebrow flex-1 text-bone/50" style="--speed:30s; --gap:2.5rem">
        {[0, 1].map((k) => (
          <ul class="marquee-track" aria-hidden={k === 1 ? 'true' : undefined}>
            {sectors.map((s) => <li class="flex items-center gap-10 whitespace-nowrap"><span>{s}</span><span class="text-signal">/</span></li>)}
          </ul>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .js .hero-fade {
    opacity: 0;
    transform: translateY(24px);
    animation: hero-in 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--intro) + 700ms + var(--k) * 120ms);
  }
  @keyframes hero-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  .scroll-cue span {
    animation: cue 1.8s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }
  @keyframes cue {
    0% { transform: translate(-50%, 0); opacity: 1; }
    70% { transform: translate(-50%, 12px); opacity: 0; }
    100% { opacity: 0; }
  }
</style>
