---
/**
 * Filtros (proyectos, noticias, media) como pestañas de texto con subrayado.
 * Mobile-first: en móvil es una fila con scroll horizontal.
 */
interface Item { value: string; label: string; count?: number }
interface Props { target: string; items: Item[]; label: string; tone?: 'light' | 'dark'; sticky?: boolean; allCount?: number; class?: string }
const { target, items, label, tone = 'light', sticky = false, allCount, class: cls = '' } = Astro.props;
const all: Item = { value: 'all', label: 'All', count: allCount };
const dark = tone === 'dark';
---
<div
  class:list={[
    'filter-bar -mx-4 px-4 md:mx-0 md:px-0',
    sticky && 'sticky top-(--header-h) z-20 bg-bone/95 backdrop-blur-sm',
    cls,
  ]}
>
  <div
    class:list={['flex w-max gap-8 border-b md:w-full', dark ? 'border-bone/15' : 'border-ink/10']}
    data-filter-group={target}
    role="toolbar"
    aria-label={label}
  >
    {
      [all, ...items].map((it, i) => (
        <button
          type="button"
          class:list={[
            'filter-tab -mb-px shrink-0 border-b-2 border-transparent py-4 text-[0.95rem] font-semibold transition-colors',
            dark ? 'text-bone/55 hover:text-bone aria-pressed:border-bone aria-pressed:text-bone' : 'text-mute hover:text-ink aria-pressed:border-signal aria-pressed:text-signal',
          ]}
          data-filter={it.value}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {it.label}
          {it.count !== undefined && <span class="ml-1 font-normal opacity-60">({it.count})</span>}
        </button>
      ))
    }
  </div>
</div>

<style>
  .filter-bar {
    overflow-x: auto;
    scrollbar-width: none;
  }
  .filter-bar::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 48rem) {
    .filter-bar {
      overflow: visible;
    }
  }
</style>
