---
interface Props { items: readonly string[]; class?: string; speed?: string }
const { items, class: cls = '', speed = '40s' } = Astro.props;
---
<div class:list={['marquee', cls]} style={`--speed:${speed}`}>
  {[0, 1].map((k) => (
    <ul class="marquee-track" aria-hidden={k === 1 ? 'true' : undefined}>
      {items.map((item) => (
        <li class="flex items-center gap-[var(--gap)] whitespace-nowrap">
          <span>{item}</span>
          <svg viewBox="0 0 24 24" class="size-[0.5em] text-signal" aria-hidden="true"><path d="M12 0l3 9 9 3-9 3-3 9-3-9-9-3 9-3z" fill="currentColor" /></svg>
        </li>
      ))}
    </ul>
  ))}
</div>
