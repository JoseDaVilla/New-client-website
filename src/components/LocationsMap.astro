---
/** Mapa estilizado del GTA (SVG propio, sin peticiones externas) con las oficinas. */
import { offices } from '@/site.config';
---
<div class="relative">
  <svg viewBox="0 0 600 300" class="draw w-full" role="img" aria-label="Office locations in the Greater Toronto Area">
    <!-- Lago Ontario -->
    <path d="M0 250 C90 238 170 252 240 236 S360 196 430 214 S540 248 600 232 V300 H0Z" class="fill-signal/10" />
    <path d="M0 250 C90 238 170 252 240 236 S360 196 430 214 S540 248 600 232" class="ln stroke-signal/40" fill="none" stroke-width="1.5" pathLength="1" style="--i:1" />
    <!-- Autopistas -->
    <g fill="none" class="stroke-current/25" stroke-width="3" stroke-linecap="round">
      <path d="M20 128 C150 122 300 118 600 112" pathLength="1" class="ln" style="--i:3" /><!-- 401 -->
      <path d="M20 60 C200 52 380 48 600 44" pathLength="1" class="ln" style="--i:5" /><!-- 407 -->
      <path d="M268 40 V232" pathLength="1" class="ln" style="--i:7" /><!-- 427 -->
      <path d="M182 30 V140" pathLength="1" class="ln" style="--i:9" /><!-- 410 -->
      <path d="M40 238 C140 226 220 232 300 220 S420 198 470 206" pathLength="1" class="ln" style="--i:11" /><!-- QEW / Gardiner -->
      <path d="M420 40 V210" pathLength="1" class="ln" style="--i:13" /><!-- 404/DVP -->
    </g>
    <g font-family="JetBrains Mono, monospace" font-size="9" letter-spacing="1" class="fill-current/45">
      <text x="560" y="106">401</text><text x="560" y="38">407</text><text x="274" y="52">427</text><text x="188" y="40">410</text><text x="60" y="228">QEW</text>
      <text x="470" y="270" class="fill-signal/60">LAKE ONTARIO</text>
      <text x="470" y="176">TORONTO</text>
    </g>
    {offices.map((o, i) => (
      <g transform={`translate(${o.map.x * 6} ${o.map.y * 3})`}>
        <circle r="20" class="pulse fill-signal/15" style={`animation-delay:${i * 0.8}s`} />
        <circle r="6" class="fill-signal" />
        <circle r="2.5" class="fill-bone" />
        <text y="-14" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="10" font-weight="600" letter-spacing="1" class="fill-current">{o.city.toUpperCase()}</text>
      </g>
    ))}
  </svg>
</div>
<style>
  .pulse {
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    from { transform: scale(0.3); opacity: 0.8; }
    to { transform: scale(1.6); opacity: 0; }
  }
</style>
