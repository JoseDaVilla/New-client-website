---
import { site } from '@/site.config';
interface Props { class?: string; mark?: boolean }
const { class: cls = '', mark = false } = Astro.props;
---
<span class:list={['inline-flex items-center gap-2.5', cls]}>
  <svg viewBox="0 0 40 40" class="size-8 shrink-0" aria-hidden="true">
    <path d="M9 5v30M31 5v30" stroke="currentColor" stroke-width="5" stroke-linecap="square" />
    <path d="M9 20h22" stroke="var(--color-signal)" stroke-width="5" />
    <path d="M9 5h4M27 5h4M9 35h4M27 35h4" stroke="currentColor" stroke-width="2" />
  </svg>
  {!mark && (
    <span class="font-wide text-[1.35rem] font-extrabold uppercase leading-none tracking-[-0.02em]">
      {site.name}<span class="text-signal">.</span>
    </span>
  )}
</span>
