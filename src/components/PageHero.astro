---
/**
 * Cabecera de páginas interiores: fondo blanco, retícula de plano y, a la derecha,
 * el icono del logo dibujado en línea (estilo plano, como el hero).
 */
import SplitText from './SplitText.astro';
import Eyebrow from './Eyebrow.astro';
import { logo } from '@/lib/logo';
interface Props { eyebrow: string; title: string; lead?: string; index?: string; accent?: string[] }
const { eyebrow, title, lead, accent = [] } = Astro.props;
---
<section class="relative overflow-hidden border-b border-ink/10 bg-bone pt-[calc(var(--header-h)+5rem)] pb-16 text-ink md:pb-24">
  <div class="bg-grid pointer-events-none absolute inset-0 text-signal/50"></div>

  <!-- Torres del logo en línea -->
  <svg viewBox="100 -30 400 520" class="draw pointer-events-none absolute -bottom-6 right-[-3rem] hidden h-[115%] w-auto md:block lg:right-[4%]" fill="none" aria-hidden="true">
    <path d="M60 461H540" class="ln stroke-ink/25" stroke-width="1" pathLength="1" style="--i:0" />
    <path d={logo.gray} class="ln stroke-gray" stroke-width="1.5" pathLength="1" style="--i:2" />
    <path d={logo.navy} class="ln stroke-signal" stroke-width="1.5" pathLength="1" style="--i:4" />
    <path d={logo.g} class="ln stroke-signal" stroke-width="1.5" pathLength="1" style="--i:6" />
    <g class="stroke-ink/20" stroke-width="1">
      <path d="M210 -20V461M321 -20V461M479 -20V461" stroke-dasharray="3 6" />
    </g>
    <g font-family="JetBrains Mono, monospace" font-size="10" letter-spacing="1" class="draw-fill fill-ink/40" style="--i:10">
      <text x="486" y="230">L+24</text><text x="486" y="110">L+36</text><text x="486" y="455">L00</text>
    </g>
  </svg>

  <div class="container-x relative">
    <Eyebrow class="mb-6 text-mute">{eyebrow}</Eyebrow>
    <SplitText as="h1" text={title} accent={accent} class="max-w-5xl font-wide text-display font-extrabold uppercase" />
    {lead && <p class="mt-8 max-w-2xl text-lead text-ink/70 md:mt-10" data-reveal style="--d:4">{lead}</p>}
    <slot />
  </div>
</section>
