---
import type { CollectionEntry } from 'astro:content';
import Media from './Media.astro';
import Icon from './Icon.astro';
interface Props { project: CollectionEntry<'projects'>; size?: 'lg' | 'md'; index?: number; eager?: boolean }
const { project, size = 'md', index = 0, eager = false } = Astro.props;
const p = project.data;
---
<a href={`/projects/${project.id}`} class="group block" data-reveal style={`--d:${index % 3}`}>
  <div class="relative overflow-hidden rounded-sm">
    <Media
      src={p.cover}
      alt={p.title}
      seed={project.id}
      variant={p.variant}
      eager={eager}
      class:list={[size === 'lg' ? 'aspect-[4/3] md:aspect-[16/11]' : 'aspect-[4/3]']}
      imgClass="transition-transform duration-[1.4s] ease-(--ease-expo) group-hover:scale-[1.06]"
      sizes={size === 'lg' ? '(min-width: 1024px) 60vw, 100vw' : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'}
    />
    <div class="absolute left-4 top-4 flex gap-2">
      <span class="eyebrow rounded-full bg-bone/90 px-3 py-1.5 text-ink backdrop-blur">{p.sector}</span>
      {p.status !== 'Completed' && <span class="eyebrow rounded-full bg-signal px-3 py-1.5 text-ink">{p.status}</span>}
    </div>
    <span class="absolute bottom-4 right-4 grid size-12 translate-y-3 place-items-center rounded-full bg-signal text-ink opacity-0 transition-all duration-500 ease-(--ease-expo) group-hover:translate-y-0 group-hover:opacity-100">
      <Icon name="arrow" class="size-5 -rotate-45" />
    </span>
  </div>
  <div class="mt-5 flex items-start justify-between gap-6">
    <div>
      <h3 class:list={['font-semiwide font-bold leading-tight tracking-tight', size === 'lg' ? 'text-3xl md:text-4xl' : 'text-2xl']}>
        <span class="link-u">{p.title}</span>
      </h3>
      <p class="mt-2 text-mute">{p.location}</p>
    </div>
    <p class="eyebrow shrink-0 pt-2 text-mute">{p.year}</p>
  </div>
</a>
