---
import { u } from '@/lib/url';
import type { CollectionEntry } from 'astro:content';
import Media from './Media.astro';
interface Props { project: CollectionEntry<'projects'>; size?: 'lg' | 'md'; index?: number; eager?: boolean }
const { project, size = 'md', index = 0, eager = false } = Astro.props;
const p = project.data;
---
<a href={u(`/projects/${project.id}`)} class="group block" data-reveal style={`--d:${index % 3}`}>
  <div class="relative overflow-hidden">
    <Media
      src={p.cover}
      alt={p.title}
      seed={project.id}
      variant={p.variant}
      eager={eager}
      class:list={[size === 'lg' ? 'aspect-[4/3] md:aspect-[16/11]' : 'aspect-[4/3]']}
      imgClass="transition-transform duration-[1.4s] ease-(--ease-expo) group-hover:scale-[1.04]"
      sizes={size === 'lg' ? '(min-width: 1024px) 60vw, 100vw' : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw'}
    />
    <span class="absolute inset-x-0 bottom-0 h-1 origin-left scale-x-0 bg-signal transition-transform duration-700 ease-(--ease-expo) group-hover:scale-x-100"></span>
  </div>
  <div class="mt-5 border-t border-ink/10 pt-4">
    <p class="text-sm text-mute">{p.sector}{p.status !== 'Completed' && <span class="text-signal-ink">, {p.status.toLowerCase()}</span>}</p>
    <h3 class:list={['mt-1.5 font-semiwide font-bold leading-tight tracking-tight text-ink', size === 'lg' ? 'text-2xl md:text-4xl' : 'text-xl md:text-2xl']}>
      {p.title}
    </h3>
    <p class="mt-2 text-mute">{p.location}, {p.year}</p>
  </div>
</a>
