---
/** Pequeño set de iconos lineales propios (24x24, stroke). */
interface Props { name: 'arrow' | 'arrow-left' | 'plus' | 'close' | 'menu' | 'play' | 'pin' | 'phone' | 'mail' | 'clock' | 'download' | 'check' | 'upload' | 'external'; class?: string }
const { name, class: cls = 'size-4' } = Astro.props;
const paths: Record<Props['name'], string> = {
  arrow: 'M5 12h14M13 6l6 6-6 6',
  'arrow-left': 'M19 12H5M11 6l-6 6 6 6',
  plus: 'M12 5v14M5 12h14',
  close: 'M6 6l12 12M18 6L6 18',
  menu: 'M4 8h16M4 16h16',
  play: 'M8 5.5v13l11-6.5z',
  pin: 'M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21zM12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z',
  phone: 'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z',
  mail: 'M3 6h18v12H3zM3 7l9 6 9-6',
  clock: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v5l3 2',
  download: 'M12 4v11M7 10l5 5 5-5M5 20h14',
  check: 'M5 12.5l4.5 4.5L19 7.5',
  upload: 'M12 16V5M7 10l5-5 5 5M5 20h14',
  external: 'M14 5h5v5M19 5l-8 8M18 14v5H5V6h5',
};
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class={cls} aria-hidden="true">
  <path d={paths[name]} fill={name === 'play' ? 'currentColor' : 'none'} />
</svg>
